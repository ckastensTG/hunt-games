msgstr "‹ Voltar"

#. Step counter in the walkthrough: step number and number of steps.
#: scenes/greybox/tutorial.gd:159
#, c-format
msgid "How to play · %d of %d"
msgstr "Como jogar · %d de %d"

#: scenes/greybox/tutorial.gd:162
msgid "Start playing"
msgstr "Começar a jogar"

#: scenes/greybox/tutorial.gd:162
msgid "Next ›"
msgstr "Próximo ›"

