msgstr "Os cachorros jogam primeiro"

#. Menu label: who plays which side (two people, against the AI, or AI vs AI).
#: scenes/greybox/hud.gd:229
msgid "Players"
msgstr "Jogadores"

#. The four AI strength levels, weakest to strongest. Later they become named opponents.
#: scenes/greybox/hud.gd:233
msgid "Novice"
msgstr "Novato"

#. The four AI strength levels, weakest to strongest. Later they become named opponents.
#: scenes/greybox/hud.gd:233
msgid "Apprentice"
msgstr "Aprendiz"

#. The four AI strength levels, weakest to strongest. Later they become named opponents.
#: scenes/greybox/hud.gd:233
msgid "Adept"
msgstr "Hábil"

#. The four AI strength levels, weakest to strongest. Later they become named opponents.
#: scenes/greybox/hud.gd:233
msgid "Master"
msgstr "Mestre"

#. Menu label: the computer opponent's strength. Keep it short.
#: scenes/greybox/hud.gd:239
msgid "AI"
msgstr "IA"

#. Menu label: the visual style of board and pieces (a noun, not "to look"). Keep it short.
#: scenes/greybox/hud.gd:247
msgid "Look"
msgstr "Visual"

#: scenes/greybox/hud.gd:256
msgid "Language"
msgstr "Idioma"

#: scenes/greybox/hud.gd:262
msgid "New game"
msgstr "Nova partida"

#: scenes/greybox/hud.gd:267
msgid "Undo"
msgstr "Desfazer"

#: scenes/greybox/hud.gd:274 tests/test_localization.gd:14
msgid "How to play"
msgstr "Como jogar"

#. Keyboard shortcuts. N, U, H and T are the keys and stay as they are.
#: scenes/greybox/hud.gd:278
msgid "N new game · U undo · H hide panels · T how to play"
msgstr "N nova partida · U desfazer · H ocultar painéis · T como jogar"

#. Button: end a chain of captures after the current jump.
#: scenes/greybox/hud.gd:304
msgid "Stop here"
msgstr "Parar aqui"

#. Title of the list of moves played so far.
#: scenes/greybox/hud.gd:322
msgid "Moves"
msgstr "Lances"

#: scenes/greybox/hud.gd:371
msgid "Play again"
msgstr "Jogar de novo"

#. Button on the game-over card: close it to look at the final position.
#: scenes/greybox/hud.gd:376
msgid "Look at the board"
msgstr "Ver o tabuleiro"

#. The AI is choosing its move. Shown after the turn banner, followed by animated dots.
#: scenes/greybox/hud.gd:419
msgid "thinking"
msgstr "pensando"

#. Two people taking turns on the same device.
#: scenes/greybox/hud.gd:435
msgid "Two players (hotseat)"
msgstr "Dois jogadores (mesmo aparelho)"

#: scenes/greybox/hud.gd:438
msgid "Watch the AI play"
msgstr "Ver a IA jogar"

#: scenes/greybox/hud.gd:468 scenes/greybox/hud.gd:517
msgid "A draw"
msgstr "Empate"

#. Pieces captured so far / captures needed to win.
#: scenes/greybox/hud.gd:475
#, c-format
msgid "Captured %d / %d"
msgstr "Capturas %d / %d"

#: scenes/greybox/hud.gd:503
msgid "No moves yet"
msgstr "Nenhum lance ainda"

#. Move list entry for putting a goat on the board. %s is a point name such as c3.
#: scenes/greybox/hud.gd:530
#, c-format
msgid "place %s"
msgstr "coloca em %s"

#: scenes/greybox/hud.gd:539
msgid "Watching the AI play both sides."
msgstr "A IA joga pelos dois lados."

#: scenes/greybox/hud.gd:543
msgid "Capture chain: pick the next landing, or stop here."
msgstr "Cadeia de capturas: escolha o próximo salto ou pare aqui."

#: scenes/greybox/hud.gd:549
msgid "Pick where it goes. A broken ring marks a capture."
msgstr "Escolha para onde vai. Um anel partido marca uma captura."

#: scenes/greybox/hud.gd:550
msgid "Pick where it goes."
msgstr "Escolha para onde vai."

#: scenes/greybox/tutorial.gd:76
msgid "Close"
msgstr "Fechar"

#. Button: play this step of the walkthrough again.
#: scenes/greybox/tutorial.gd:80
