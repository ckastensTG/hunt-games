msgid "Opponent ready — play now?"
msgstr "Соперник найден — играть сейчас?"

#: scenes/play/match_ui.gd:271
msgid "Your opponent offers a draw."
msgstr "Соперник предлагает ничью."

#: scenes/play/match_ui.gd:271 scenes/play/match_ui.gd:277
msgid "Accept"
