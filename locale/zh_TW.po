msgid ""
msgstr ""
"Project-Id-Version: Timeless Games: hunt-games\n"
"Language: zh_TW\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"
"X-Translator: Claude (2026-11-06)\n"
"X-Review-Status: adapted from zh_CN with Taiwan vocabulary (not converted character by character); translation confidence good; NEEDS native-speaker review before release (bible §7)\n"

#. Shown while the board and pieces of another look are prepared (it can take a few seconds).
#: scenes/greybox/greybox.gd:941
msgid "Loading…"
msgstr "載入中…"

#: scenes/greybox/hud.gd:140
msgid "Menu"
msgstr "選單"

#: scenes/greybox/hud.gd:164
msgid "Undo"
msgstr "悔棋"

#. Button: end a chain of captures after the current jump.
#: scenes/greybox/hud.gd:235
msgid "Stop here"
msgstr "到此為止"

#. Title of the list of moves played so far.
#: scenes/greybox/hud.gd:254
msgid "Moves"
msgstr "棋步"

#. Button after a game against another player: play them again (sides swap).
#: scenes/greybox/hud.gd:305 scenes/greybox/hud.gd:484
msgid "Play again"
msgstr "再來一局"

#. Button after an online quick match: look for someone else to play.
#: scenes/greybox/hud.gd:315
msgid "New opponent"
msgstr "換個對手"

#. Button on the game-over card: back to the main menu.
#: scenes/greybox/hud.gd:320
msgid "Main menu"
msgstr "主選單"

#. Button on the game-over card: close it to look at the final position.
#: scenes/greybox/hud.gd:324
msgid "Look at the board"
msgstr "查看棋盤"

#. The AI is choosing its move. Shown after the turn banner, followed by animated dots.
#: scenes/greybox/hud.gd:390
msgid "thinking"
msgstr "思考中"

#: scenes/greybox/hud.gd:423 scenes/greybox/hud.gd:472
msgid "A draw"
msgstr "和局"

#. Pieces captured so far / captures needed to win.
#: scenes/greybox/hud.gd:430
#, c-format
msgid "Captured %d / %d"
msgstr "已吃 %d / %d"

#: scenes/greybox/hud.gd:458
msgid "No moves yet"
msgstr "尚無棋步"

#. Small line above the result when one player is on this device.
#: scenes/greybox/hud.gd:478 tools/smoke_multiplayer.gd:302
msgid "You won"
msgstr "你贏了"

#. Small line above the result when one player is on this device.
#: scenes/greybox/hud.gd:478 tools/smoke_multiplayer.gd:155
msgid "You lost"
msgstr "你輸了"

#. Button after a game against another player: play them again (sides swap).
#: scenes/greybox/hud.gd:484 tools/smoke_multiplayer.gd:157
msgid "Rematch"
msgstr "再戰一局"

#. Move list entry for putting a goat on the board. %s is a point name such as c3.
#: scenes/greybox/hud.gd:496
#, c-format
msgid "place %s"
msgstr "放在 %s"

#: scenes/greybox/hud.gd:505
msgid "Watching the AI play both sides."
msgstr "電腦正在替雙方下棋。"

#: scenes/greybox/hud.gd:509
msgid "Waiting for your opponent's move."
msgstr "等待對手下棋。"

#: scenes/greybox/hud.gd:511
msgid "Capture chain: pick the next landing, or stop here."
msgstr "連跳吃子：選擇下一個落點，或到此為止。"

#: scenes/greybox/hud.gd:517
msgid "Pick where it goes. A broken ring marks a capture."
msgstr "選擇去向。斷開的圓環表示吃子。"

#: scenes/greybox/hud.gd:518
msgid "Pick where it goes."
msgstr "選擇去向。"

#: scenes/greybox/tutorial.gd:79
msgid "Close"
msgstr "關閉"

#. Button: play this step of the walkthrough again.
#: scenes/greybox/tutorial.gd:83
msgid "Replay"
msgstr "重播"

#: scenes/greybox/tutorial.gd:86
msgid "‹ Back"
msgstr "‹ 上一步"

#. Step counter in the walkthrough: step number and number of steps.
#: scenes/greybox/tutorial.gd:175
#, c-format
msgid "How to play · %d of %d"
msgstr "玩法 · 第 %d 步，共 %d 步"

#: scenes/greybox/tutorial.gd:178
msgid "Start playing"
msgstr "開始對局"

#: scenes/greybox/tutorial.gd:178
msgid "Next ›"
msgstr "下一步 ›"

#. A small line over the board while the game keeps looking for an online opponent in the background.
#. Quick match is searching for an online opponent.
#: scenes/play/match_ui.gd:92 scenes/play/play_menu.gd:659
msgid "Looking for an opponent…"
msgstr "正在尋找對手…"

#. Button: stop looking for an online opponent.
#: scenes/play/match_ui.gd:95
msgid "Stop looking"
msgstr "停止尋找"

#. Button on "Opponent ready — play now?": leave the AI game (it's saved) and start the online game.
#: scenes/play/match_ui.gd:126
msgid "Play now"
msgstr "立即開始"

#. Button on "Opponent ready — play now?": keep playing the AI and stop looking.
#: scenes/play/match_ui.gd:133 scenes/play/play_menu.gd:991
msgid "Not now"
msgstr "先不要"

#. The connection to the other player dropped. %d is the seconds left before the game is given up.
#: scenes/play/match_ui.gd:229
#, c-format
msgid "Reconnecting… %d s"
msgstr "正在重新連線… %d 秒"

#. The other player's device can no longer be reached.
#: scenes/play/match_ui.gd:233
msgid "Disconnected"
msgstr "已中斷連線"

#. A quick-match opponent was found while the player plays the AI. Short: it sits over the board with two buttons.
#: scenes/play/match_ui.gd:261
msgid "Opponent ready — play now?"
msgstr "對手已就緒，要立即開始嗎？"

#: scenes/play/match_ui.gd:271
msgid "Your opponent offers a draw."
msgstr "對手提議和局。"

#: scenes/play/match_ui.gd:271 scenes/play/match_ui.gd:274
msgid "Accept"
msgstr "接受"

#: scenes/play/match_ui.gd:271 scenes/play/match_ui.gd:274
msgid "Decline"
msgstr "拒絕"

#: scenes/play/match_ui.gd:274
msgid "Your opponent wants a rematch."
msgstr "對手想再戰一局。"

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:281
msgid "Resign this game?"
msgstr "要認輸嗎？"

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:281 scenes/play/play_menu.gd:767
msgid "Resign"
msgstr "認輸"

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:281
msgid "Keep playing"
msgstr "繼續下棋"

#: scenes/play/play_controller.gd:281
msgid "We'll let you know when an opponent is ready."
msgstr "對手就緒時會通知你。"

#: scenes/play/play_controller.gd:315
msgid "Draw offered. Waiting for an answer."
msgstr "已提議和局，等待對方回覆。"

#: scenes/play/play_controller.gd:326
msgid "Rematch offered. Waiting for an answer."
msgstr "已邀請再戰，等待對方回覆。"

#: scenes/play/play_controller.gd:328 scenes/play/play_controller.gd:425 scenes/play/play_text.gd:81 tools/smoke_multiplayer.gd:301
msgid "Your opponent left the game."
msgstr "對手已離開對局。"

#: scenes/play/play_controller.gd:422
msgid "Reconnected."
msgstr "已重新連線。"

#: scenes/play/play_controller.gd:432 tools/smoke_multiplayer.gd:146
msgid "Your opponent declined the draw."
msgstr "對手拒絕了和局。"

#: scenes/play/play_controller.gd:433
msgid "Your opponent declined the rematch."
msgstr "對手拒絕了再戰。"

#. Shown when a game with another player starts. %s is their name, e.g. "Scribe 4821".
#: scenes/play/play_controller.gd:450
#, c-format
msgid "Playing against %s"
msgstr "對手：%s"

#: scenes/play/play_controller.gd:460
msgid "The other player didn't connect. Still looking…"
msgstr "對方未能連線，繼續尋找…"

#. The turn clock in online quick match ran out. %d is 1 or 2; at 3 the game is lost.
#: scenes/play/play_controller.gd:509
#, c-format
msgid "Time ran out, so a move was played for you (%d of 3)."
msgstr "時間到，已替你下了一步（第 %d 次，共 3 次）。"

#: scenes/play/play_menu.gd:282 tools/smoke_greybox.gd:276
msgid "Back"
msgstr "返回"

#: scenes/play/play_menu.gd:337
msgid "Rules"
msgstr "規則"

#: scenes/play/play_menu.gd:357
msgid "Language"
msgstr "語言"

#. Menu button: go back to the game that was set aside.
#: scenes/play/play_menu.gd:383 scenes/play/play_menu.gd:757
msgid "Continue"
msgstr "繼續"

#: scenes/play/play_menu.gd:384 scenes/play/play_menu.gd:413
msgid "Play against the AI"
msgstr "與電腦對弈"

#. Menu button: two people share this device and take turns.
#: scenes/play/play_menu.gd:386 scenes/play/play_menu.gd:433
msgid "Pass and play"
msgstr "同機雙人"

#. Menu button: play with someone on the same Wi-Fi network (each on their own device).
#: scenes/play/play_menu.gd:388 scenes/play/play_menu.gd:442
msgid "Play local"
msgstr "區域網路對戰"

#: scenes/play/play_menu.gd:390 scenes/play/play_menu.gd:545
msgid "Play online"
msgstr "線上對戰"

#: scenes/play/play_menu.gd:391 tests/test_localization.gd:14
msgid "How to play"
msgstr "玩法"

#. Main menu button: opens a short history of the game, with its sources.
#: scenes/play/play_menu.gd:394 scenes/play/play_menu.gd:702
msgid "Game origins"
msgstr "遊戲起源"

#. Main menu button and the title of its screen: look, graphics, sound, music, language and purchases, set before a game. Keep it short.
#: scenes/play/play_menu.gd:396 scenes/play/play_menu.gd:816 tools/smoke_greybox.gd:240
msgid "Settings"
msgstr "設定"

#. Main menu button: close the game completely.
#: scenes/play/play_menu.gd:404
msgid "Quit game"
msgstr "結束遊戲"

#: scenes/play/play_menu.gd:417
msgid "Novice"
msgstr "新手"

#: scenes/play/play_menu.gd:417
msgid "Apprentice"
msgstr "學徒"

#: scenes/play/play_menu.gd:417
msgid "Adept"
msgstr "高手"

#: scenes/play/play_menu.gd:417
msgid "Master"
msgstr "大師"

#. Menu label: how strong the computer opponent is.
#. Shown instead of a player's name when it can't be read.
#: scenes/play/play_menu.gd:422 scenes/play/play_text.gd:15
msgid "Opponent"
msgstr "對手"

#: scenes/play/play_menu.gd:425 scenes/play/play_menu.gd:437 scenes/play/play_menu.gd:461
msgid "Start"
msgstr "開始"

#: scenes/play/play_menu.gd:434
msgid "Two players share this device and take turns."
msgstr "兩位玩家共用這台裝置，輪流下棋。"

#: scenes/play/play_menu.gd:443
msgid "Both devices need to be on the same Wi-Fi."
msgstr "兩台裝置需連上同一個 Wi-Fi。"

#. Menu button: start a game that another device on the same Wi-Fi can join.
#: scenes/play/play_menu.gd:446 scenes/play/play_menu.gd:457
msgid "Host a game"
msgstr "建立對局"

#. Menu button: join a game another device on the same Wi-Fi is hosting.
#: scenes/play/play_menu.gd:448 scenes/play/play_menu.gd:489
msgid "Join a game"
msgstr "加入對局"

#: scenes/play/play_menu.gd:457 scenes/play/play_menu.gd:576
msgid "Create a code"
msgstr "產生代碼"

#: scenes/play/play_menu.gd:475
msgid "Waiting for a player"
msgstr "等待玩家加入"

#: scenes/play/play_menu.gd:476
msgid "On the other device, choose Play local, then Join a game."
msgstr "在另一台裝置上選擇「區域網路對戰」，再選擇「加入對局」。"

#. Above a code like 7KQ-2M4P that the other player can type to join.
#: scenes/play/play_menu.gd:480
msgid "If the game doesn't appear there, enter this code"
msgstr "如果那邊沒有出現這局，請輸入此代碼"

#: scenes/play/play_menu.gd:485 scenes/play/play_menu.gd:605 scenes/play/play_menu.gd:656 scenes/play/play_menu.gd:663 scenes/play/play_menu.gd:668
msgid "Cancel"
msgstr "取消"

#. Shown while listening for games hosted on the same Wi-Fi; a list of games appears below.
#: scenes/play/play_menu.gd:491
msgid "Looking for games on this Wi-Fi…"
msgstr "正在此 Wi-Fi 中尋找對局…"

#. Placeholder in the box for typing a nearby game's code.
#: scenes/play/play_menu.gd:502
msgid "Code"
msgstr "代碼"

#: scenes/play/play_menu.gd:510 scenes/play/play_menu.gd:637
msgid "Join"
msgstr "加入"

#. Menu button: quick match against a random online player.
#: scenes/play/play_menu.gd:547
msgid "Play with someone online"
msgstr "與線上玩家對戰"

#. Small print under "Play with someone online".
#: scenes/play/play_menu.gd:552 scenes/play/play_menu.gd:661
msgid "Standard rules, about a minute per move"
msgstr "標準規則，每步約一分鐘"

#: scenes/play/play_menu.gd:553 scenes/play/play_menu.gd:573
msgid "Play with a friend"
msgstr "與好友對戰"

#: scenes/play/play_menu.gd:574
msgid "One of you creates a code, the other enters it. It works between phones, tablets and computers."
msgstr "一人產生代碼，另一人輸入。手機、平板和電腦之間都能對戰。"

#: scenes/play/play_menu.gd:577 scenes/play/play_menu.gd:621
msgid "Enter a code"
msgstr "輸入代碼"

#: scenes/play/play_menu.gd:585
msgid "Your code"
msgstr "你的代碼"

#: scenes/play/play_menu.gd:587 scenes/play/play_menu.gd:667
msgid "Connecting…"
msgstr "正在連線…"

#: scenes/play/play_menu.gd:590
msgid "Send this code to your friend. The game starts when they enter it."
msgstr "把代碼傳給好友，對方輸入後對局就會開始。"

#: scenes/play/play_menu.gd:593
msgid "Share"
msgstr "分享"

#: scenes/play/play_menu.gd:595
msgid "Copy"
msgstr "複製"

#. Toast after copying the game code.
#: scenes/play/play_menu.gd:598 scenes/play/play_menu.gd:617
msgid "Copied"
msgstr "已複製"

#. Message sent with the system share sheet. %s is a code like TG-7KQ2.
#: scenes/play/play_menu.gd:611
#, c-format
msgid "Play with me in Timeless Games! My game code is %s."
msgstr "來 Timeless Games 和我下一局吧！我的對局代碼是 %s。"

#. Quick match found no one after about a minute.
#: scenes/play/play_menu.gd:647
msgid "No one is free right now"
msgstr "目前沒有空閒的玩家"

#: scenes/play/play_menu.gd:648
msgid "We can keep looking while you play."
msgstr "你下棋時我們可以繼續尋找。"

#: scenes/play/play_menu.gd:649
msgid "Play against the AI while we keep looking"
msgstr "先與電腦對弈，同時繼續尋找"

#: scenes/play/play_menu.gd:652
msgid "Keep searching"
msgstr "繼續尋找"

#: scenes/play/play_menu.gd:653
msgid "Invite a friend instead"
msgstr "改為邀請好友"

#. Title over a message saying why a game with another player couldn't start.
#: scenes/play/play_menu.gd:673
msgid "Couldn't start the game"
msgstr "無法開始對局"

#: scenes/play/play_menu.gd:676
msgid "OK"
msgstr "確定"

#. Asked before leaving a game against another player that's still going.
#: scenes/play/play_menu.gd:684
msgid "Leave this game?"
msgstr "要離開這局嗎？"

#: scenes/play/play_menu.gd:685
msgid "It counts as a loss."
msgstr "這將算作輸棋。"

#: scenes/play/play_menu.gd:686
msgid "Leave"
msgstr "離開"

#. Button: don't leave the game against another player.
#: scenes/play/play_menu.gd:692
msgid "Stay"
msgstr "留下"

#. Heading over the list of books and articles at the end of "Game origins".
#: scenes/play/play_menu.gd:717
msgid "Sources"
msgstr "資料來源"

#: scenes/play/play_menu.gd:763
msgid "Offer a draw"
msgstr "提議和局"

#. In-game menu button: end this game and go back to the main menu.
#: scenes/play/play_menu.gd:803
msgid "Quit to main menu"
msgstr "回到主選單"

#. Menu label: the visual style of board and pieces (a noun, not "to look"). Keep it short.
#: scenes/play/play_menu.gd:845
msgid "Look"
msgstr "外觀"

#. Settings label next to an on/off switch and a volume slider: the game's sound effects (pieces, end of game). Keep it short.
#: scenes/play/play_menu.gd:848
msgid "Sound"
msgstr "音效"

#. Settings label next to an on/off switch and a volume slider: the game's music. Keep it short.
#: scenes/play/play_menu.gd:850
msgid "Music"
msgstr "音樂"

#. Settings button: opens Game Center (iPhone/iPad) or Google Play Games (Android) on the game's achievements. The usual platform word.
#: scenes/play/play_menu.gd:863
msgid "Achievements"
msgstr "成就"

#. Message when Game Center or Google Play Games can't open (not signed in, offline).
#: scenes/play/play_menu.gd:867
msgid "Achievements aren't available right now."
msgstr "成就目前無法使用。"

#. Settings button and screen title: who made the game, and the open-source licences.
#: scenes/play/play_menu.gd:869 scenes/play/play_menu.gd:880 tools/smoke_greybox.gd:253
msgid "Credits"
msgstr "製作群"

#. On the Credits screen. First %s: the game's name (e.g. "Bagh Chal"); second %s: the name of the person who made it.
#: scenes/play/play_menu.gd:883
#, c-format
msgid "%s is a game by %s."
msgstr "%s 是由 %s 製作的遊戲。"

#. Button and screen title: the licences of the open-source software and fonts the game uses.
#: scenes/play/play_menu.gd:886 scenes/play/play_menu.gd:893 tools/smoke_greybox.gd:260
msgid "Open-source licenses"
msgstr "開放原始碼授權"

#. On the "Open-source licenses" screen, above the list. "Tap" also covers clicking.
#: scenes/play/play_menu.gd:895
msgid "This game is made with the software and fonts below. Tap one to read its license."
msgstr "本遊戲使用了以下軟體與字型。點一下任一項即可閱讀其授權。"

#. Title of the screen offering the other looks (styles of board and pieces) for a short video.
#: scenes/play/play_menu.gd:963
msgid "More looks"
msgstr "更多外觀"

#. On the "More looks" screen. The video is an ad; "until you close the game" means until the app is closed.
#: scenes/play/play_menu.gd:965
msgid "Watch a short video to switch looks until you close the game."
msgstr "觀看一段短影片，即可在關閉遊戲前隨意切換外觀。"

#. On the "More looks" screen when no video could be loaded (offline, or none available).
#: scenes/play/play_menu.gd:969
msgid "No video is ready right now. Try again in a moment."
msgstr "目前沒有可播放的影片，請稍後再試。"

#. Button: play a short video (an ad) to open the other looks.
#: scenes/play/play_menu.gd:972
msgid "Watch a video"
msgstr "觀看影片"

#. On the "More looks" screen, above the Remove ads button: buying it opens every look permanently.
#: scenes/play/play_menu.gd:988
msgid "Or remove ads to keep every look for good."
msgstr "或者移除廣告，永久保留所有外觀。"

#. Button: buy "Remove ads" (no more ads, and every look of the board open for good). %s is the store's price, e.g. "US$1.99". Keep it short.
#: scenes/play/play_menu.gd:989 scenes/play/play_menu.gd:1003 tools/smoke_greybox.gd:218 tools/smoke_greybox.gd:250
#, c-format
msgid "Remove ads · %s"
msgstr "移除廣告 · %s"

#. In-game menu button: get back a purchase made before with the same store account (a new phone, a reinstall). The usual store wording. Shares a row with "Privacy choices".
#: scenes/play/play_menu.gd:1009 tools/smoke_greybox.gd:227
msgid "Restore purchases"
msgstr "恢復購買"

#. In-game menu button: shows Google's consent form again, to change the choice about ads and personal data.
#: scenes/play/play_menu.gd:1013
msgid "Privacy choices"
msgstr "隱私權選項"

#. Message after buying "Remove ads": thanks, no more ads, and every look (style of board and pieces) is theirs.
#: scenes/play/play_menu.gd:1032
msgid "Thank you! Ads are off and every look is yours."
msgstr "謝謝！廣告已關閉，所有外觀都歸你了。"

#. Message when the store holds the payment for "Remove ads" (e.g. paying in cash, or a parent must approve).
#: scenes/play/play_menu.gd:1042
msgid "Your payment is pending. Ads will turn off as soon as it goes through."
msgstr "你的付款正在處理中。付款完成後廣告就會關閉。"

#. Message when buying "Remove ads" failed (not when the player cancelled).
#: scenes/play/play_menu.gd:1045
msgid "The purchase didn't go through. Please try again later."
msgstr "購買未能完成，請稍後再試。"

#. Message after "Restore purchases" found Remove ads.
#: scenes/play/play_menu.gd:1055
msgid "Your purchase is restored."
msgstr "已恢復你的購買。"

#. Message after "Restore purchases" found nothing bought with this store account.
#: scenes/play/play_menu.gd:1058
msgid "No purchase to restore on this account."
msgstr "此帳號沒有可恢復的購買。"

#. Message when the store (Google Play, the App Store) can't be reached.
#: scenes/play/play_menu.gd:1061
msgid "The store isn't available right now."
msgstr "商店目前無法使用。"

#. Settings label next to a list: the graphics quality (Auto, High, Medium, Low). Keep it short.
#: scenes/play/play_menu.gd:1083
msgid "Graphics"
msgstr "畫質"

#. Followed by this player's name as others see it, e.g. "Your name: Potter 4821".
#: scenes/play/play_menu.gd:1164
#, c-format
msgid "Your name: %s"
msgstr "你的名字：%s"

#. Shown, with animated dots, while waiting for the other player to join.
#: scenes/play/play_menu.gd:1201
msgid "Waiting"
msgstr "等待中"

#: scenes/play/play_text.gd:24
msgid "Scribe"
msgstr "書吏"

#: scenes/play/play_text.gd:26
msgid "Traveller"
msgstr "旅人"

#: scenes/play/play_text.gd:28
msgid "Potter"
msgstr "陶匠"

#: scenes/play/play_text.gd:30 tools/smoke_multiplayer.gd:285
msgid "Weaver"
msgstr "織工"

#: scenes/play/play_text.gd:32
msgid "Shepherd"
msgstr "牧人"

#: scenes/play/play_text.gd:34
msgid "Boatman"
msgstr "船夫"

#: scenes/play/play_text.gd:36
msgid "Gardener"
msgstr "園丁"

#: scenes/play/play_text.gd:38
msgid "Builder"
msgstr "工匠"

#: scenes/play/play_text.gd:46
msgid "Can't reach the online service. Check your connection and try again."
msgstr "無法連上線上服務。請檢查網路連線後再試一次。"

#: scenes/play/play_text.gd:48
msgid "No game has that code. Check it and try again."
msgstr "沒有使用這個代碼的對局。請確認後再試一次。"

#: scenes/play/play_text.gd:50
msgid "That game has already started."
msgstr "該對局已經開始。"

#: scenes/play/play_text.gd:52
msgid "Couldn't connect to the other device."
msgstr "無法連線到另一台裝置。"

#: scenes/play/play_text.gd:54
msgid "The other device has a different version of the game. Update both and try again."
msgstr "另一台裝置的遊戲版本不同。請兩台都更新後再試一次。"

#: scenes/play/play_text.gd:56
