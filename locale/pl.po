msgid ""
msgstr ""
"Project-Id-Version: Timeless Games: hunt-games\n"
"Language: pl\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"
"X-Translator: Claude (2026-11-03)\n"
"X-Review-Status: translation confidence good; NEEDS native-speaker review before release (bible §7)\n"

#. Shown while the board and pieces of another look are prepared (it can take a few seconds).
#: scenes/greybox/greybox.gd:931
msgid "Loading…"
msgstr "Wczytywanie…"

#: scenes/greybox/hud.gd:140
msgid "Menu"
msgstr "Menu"

#: scenes/greybox/hud.gd:164
msgid "Undo"
msgstr "Cofnij"

#. Button: end a chain of captures after the current jump.
#: scenes/greybox/hud.gd:235
msgid "Stop here"
msgstr "Zatrzymaj się"

#. Title of the list of moves played so far.
#: scenes/greybox/hud.gd:254
msgid "Moves"
msgstr "Ruchy"

#. Button after a game against another player: play them again (sides swap).
#: scenes/greybox/hud.gd:305 scenes/greybox/hud.gd:484
msgid "Play again"
msgstr "Zagraj ponownie"

#. Button after an online quick match: look for someone else to play.
#: scenes/greybox/hud.gd:315
msgid "New opponent"
msgstr "Nowy przeciwnik"

#. Button on the game-over card: back to the main menu.
#: scenes/greybox/hud.gd:320
msgid "Main menu"
msgstr "Menu główne"

#. Button on the game-over card: close it to look at the final position.
#: scenes/greybox/hud.gd:324
msgid "Look at the board"
msgstr "Obejrzyj planszę"

#. The AI is choosing its move. Shown after the turn banner, followed by animated dots.
#: scenes/greybox/hud.gd:390
msgid "thinking"
msgstr "myśli"

#: scenes/greybox/hud.gd:423 scenes/greybox/hud.gd:472
msgid "A draw"
msgstr "Remis"

#. Pieces captured so far / captures needed to win.
#: scenes/greybox/hud.gd:430
#, c-format
msgid "Captured %d / %d"
msgstr "Zbite: %d / %d"

#: scenes/greybox/hud.gd:458
msgid "No moves yet"
msgstr "Brak ruchów"

#. Small line above the result when one player is on this device.
#: scenes/greybox/hud.gd:478 tools/smoke_multiplayer.gd:302
msgid "You won"
msgstr "Wygrywasz"

#. Small line above the result when one player is on this device.
#: scenes/greybox/hud.gd:478 tools/smoke_multiplayer.gd:155
msgid "You lost"
msgstr "Przegrywasz"

#. Button after a game against another player: play them again (sides swap).
#: scenes/greybox/hud.gd:484 tools/smoke_multiplayer.gd:157
msgid "Rematch"
msgstr "Rewanż"

#. Move list entry for putting a goat on the board. %s is a point name such as c3.
#: scenes/greybox/hud.gd:496
#, c-format
msgid "place %s"
msgstr "postawienie na %s"

#: scenes/greybox/hud.gd:505
msgid "Watching the AI play both sides."
msgstr "SI gra obiema stronami."

#: scenes/greybox/hud.gd:509
msgid "Waiting for your opponent's move."
msgstr "Czekamy na ruch przeciwnika."

#: scenes/greybox/hud.gd:511
msgid "Capture chain: pick the next landing, or stop here."
msgstr "Seria bić: wybierz następny skok albo zatrzymaj się."

#: scenes/greybox/hud.gd:517
msgid "Pick where it goes. A broken ring marks a capture."
msgstr "Wybierz, dokąd idzie. Przerwany pierścień oznacza bicie."

#: scenes/greybox/hud.gd:518
msgid "Pick where it goes."
msgstr "Wybierz, dokąd idzie."

#: scenes/greybox/tutorial.gd:79
msgid "Close"
msgstr "Zamknij"

#. Button: play this step of the walkthrough again.
#: scenes/greybox/tutorial.gd:83
msgid "Replay"
msgstr "Powtórz"

#: scenes/greybox/tutorial.gd:86
msgid "‹ Back"
msgstr "‹ Wstecz"

#. Step counter in the walkthrough: step number and number of steps.
#: scenes/greybox/tutorial.gd:175
#, c-format
msgid "How to play · %d of %d"
msgstr "Jak grać · %d z %d"

#: scenes/greybox/tutorial.gd:178
msgid "Start playing"
msgstr "Zacznij grać"

#: scenes/greybox/tutorial.gd:178
msgid "Next ›"
msgstr "Dalej ›"

#. A small line over the board while the game keeps looking for an online opponent in the background.
#. Quick match is searching for an online opponent.
#: scenes/play/match_ui.gd:92 scenes/play/play_menu.gd:645
msgid "Looking for an opponent…"
msgstr "Szukamy przeciwnika…"

#. Button: stop looking for an online opponent.
#: scenes/play/match_ui.gd:95
msgid "Stop looking"
msgstr "Przestań szukać"

#. Button on "Opponent ready — play now?": leave the AI game (it's saved) and start the online game.
#: scenes/play/match_ui.gd:126
msgid "Play now"
msgstr "Graj teraz"

#. Button on "Opponent ready — play now?": keep playing the AI and stop looking.
#: scenes/play/match_ui.gd:133 scenes/play/play_menu.gd:874
msgid "Not now"
msgstr "Nie teraz"

#. The connection to the other player dropped. %d is the seconds left before the game is given up.
#: scenes/play/match_ui.gd:229
#, c-format
msgid "Reconnecting… %d s"
msgstr "Ponowne łączenie… %d s"

#. The other player's device can no longer be reached.
#: scenes/play/match_ui.gd:233
msgid "Disconnected"
msgstr "Rozłączono"

#. A quick-match opponent was found while the player plays the AI. Short: it sits over the board with two buttons.
#: scenes/play/match_ui.gd:261
msgid "Opponent ready — play now?"
msgstr "Przeciwnik gotowy — grasz teraz?"

#: scenes/play/match_ui.gd:271
msgid "Your opponent offers a draw."
msgstr "Przeciwnik proponuje remis."

#: scenes/play/match_ui.gd:271 scenes/play/match_ui.gd:274
msgid "Accept"
msgstr "Przyjmij"

#: scenes/play/match_ui.gd:271 scenes/play/match_ui.gd:274
msgid "Decline"
msgstr "Odrzuć"

#: scenes/play/match_ui.gd:274
msgid "Your opponent wants a rematch."
msgstr "Przeciwnik chce rewanżu."

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:281
msgid "Resign this game?"
msgstr "Poddać tę partię?"

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:281 scenes/play/play_menu.gd:753
msgid "Resign"
msgstr "Poddaj się"

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:281
msgid "Keep playing"
msgstr "Graj dalej"

#: scenes/play/play_controller.gd:281
msgid "We'll let you know when an opponent is ready."
msgstr "Damy znać, gdy przeciwnik będzie gotowy."

#: scenes/play/play_controller.gd:315
msgid "Draw offered. Waiting for an answer."
msgstr "Zaproponowano remis. Czekamy na odpowiedź."

#: scenes/play/play_controller.gd:326
msgid "Rematch offered. Waiting for an answer."
msgstr "Zaproponowano rewanż. Czekamy na odpowiedź."

#: scenes/play/play_controller.gd:328 scenes/play/play_controller.gd:425 scenes/play/play_text.gd:81 tools/smoke_multiplayer.gd:301
msgid "Your opponent left the game."
msgstr "Przeciwnik opuścił grę."

#: scenes/play/play_controller.gd:422
msgid "Reconnected."
msgstr "Połączono ponownie."

#: scenes/play/play_controller.gd:432 tools/smoke_multiplayer.gd:146
msgid "Your opponent declined the draw."
msgstr "Przeciwnik odrzucił remis."

#: scenes/play/play_controller.gd:433
msgid "Your opponent declined the rematch."
msgstr "Przeciwnik odrzucił rewanż."

#. Shown when a game with another player starts. %s is their name, e.g. "Scribe 4821".
#: scenes/play/play_controller.gd:450
#, c-format
msgid "Playing against %s"
msgstr "Twój przeciwnik: %s"

#: scenes/play/play_controller.gd:460
msgid "The other player didn't connect. Still looking…"
msgstr "Drugi gracz się nie połączył. Szukamy dalej…"

#. The turn clock in online quick match ran out. %d is 1 or 2; at 3 the game is lost.
#: scenes/play/play_controller.gd:509
#, c-format
msgid "Time ran out, so a move was played for you (%d of 3)."
msgstr "Czas minął, wykonano ruch za ciebie (%d z 3)."

#: scenes/play/play_menu.gd:268
msgid "Back"
msgstr "Wstecz"

#: scenes/play/play_menu.gd:323
msgid "Rules"
msgstr "Zasady"

#: scenes/play/play_menu.gd:343
msgid "Language"
msgstr "Język"

#. Menu button: go back to the game that was set aside.
#: scenes/play/play_menu.gd:369 scenes/play/play_menu.gd:743
msgid "Continue"
msgstr "Kontynuuj"

#: scenes/play/play_menu.gd:370 scenes/play/play_menu.gd:399
msgid "Play against the AI"
msgstr "Graj przeciwko SI"

#. Menu button: two people share this device and take turns.
#: scenes/play/play_menu.gd:372 scenes/play/play_menu.gd:419
msgid "Pass and play"
msgstr "We dwoje na jednym urządzeniu"

#. Menu button: play with someone on the same Wi-Fi network (each on their own device).
#: scenes/play/play_menu.gd:374 scenes/play/play_menu.gd:428
msgid "Play local"
msgstr "Graj lokalnie"

#: scenes/play/play_menu.gd:376 scenes/play/play_menu.gd:531
msgid "Play online"
msgstr "Graj online"

#: scenes/play/play_menu.gd:377 tests/test_localization.gd:14
msgid "How to play"
msgstr "Jak grać"

#. Main menu button: opens a short history of the game, with its sources.
#: scenes/play/play_menu.gd:380 scenes/play/play_menu.gd:688
msgid "Game origins"
msgstr "Pochodzenie gry"

#. Main menu button and the title of its screen: look, graphics, sound, music, language and purchases, set before a game. Keep it short.
#: scenes/play/play_menu.gd:382 scenes/play/play_menu.gd:802
msgid "Settings"
msgstr "Ustawienia"

#. Main menu button: close the game completely.
#: scenes/play/play_menu.gd:390
msgid "Quit game"
msgstr "Wyjdź z gry"

#: scenes/play/play_menu.gd:403
msgid "Novice"
msgstr "Nowicjusz"

#: scenes/play/play_menu.gd:403
msgid "Apprentice"
msgstr "Uczeń"

#: scenes/play/play_menu.gd:403
msgid "Adept"
msgstr "Znawca"

#: scenes/play/play_menu.gd:403
msgid "Master"
msgstr "Mistrz"

#. Menu label: how strong the computer opponent is.
#. Shown instead of a player's name when it can't be read.
#: scenes/play/play_menu.gd:408 scenes/play/play_text.gd:15
msgid "Opponent"
msgstr "Przeciwnik"

#: scenes/play/play_menu.gd:411 scenes/play/play_menu.gd:423 scenes/play/play_menu.gd:447
msgid "Start"
msgstr "Zacznij"

#: scenes/play/play_menu.gd:420
msgid "Two players share this device and take turns."
msgstr "Dwóch graczy dzieli to urządzenie i gra na zmianę."

#: scenes/play/play_menu.gd:429
msgid "Both devices need to be on the same Wi-Fi."
msgstr "Oba urządzenia muszą być w tej samej sieci Wi-Fi."

#. Menu button: start a game that another device on the same Wi-Fi can join.
#: scenes/play/play_menu.gd:432 scenes/play/play_menu.gd:443
msgid "Host a game"
msgstr "Utwórz grę"

#. Menu button: join a game another device on the same Wi-Fi is hosting.
#: scenes/play/play_menu.gd:434 scenes/play/play_menu.gd:475
msgid "Join a game"
msgstr "Dołącz do gry"

#: scenes/play/play_menu.gd:443 scenes/play/play_menu.gd:562
msgid "Create a code"
msgstr "Utwórz kod"

#: scenes/play/play_menu.gd:461
msgid "Waiting for a player"
msgstr "Czekamy na gracza"

#: scenes/play/play_menu.gd:462
msgid "On the other device, choose Play local, then Join a game."
msgstr "Na drugim urządzeniu wybierz Graj lokalnie, a potem Dołącz do gry."

#. Above a code like 7KQ-2M4P that the other player can type to join.
#: scenes/play/play_menu.gd:466
msgid "If the game doesn't appear there, enter this code"
msgstr "Jeśli gra się tam nie pojawi, wpisz ten kod"

#: scenes/play/play_menu.gd:471 scenes/play/play_menu.gd:591 scenes/play/play_menu.gd:642 scenes/play/play_menu.gd:649 scenes/play/play_menu.gd:654
msgid "Cancel"
msgstr "Anuluj"

#. Shown while listening for games hosted on the same Wi-Fi; a list of games appears below.
#: scenes/play/play_menu.gd:477
msgid "Looking for games on this Wi-Fi…"
msgstr "Szukamy gier w tej sieci Wi-Fi…"

#. Placeholder in the box for typing a nearby game's code.
#: scenes/play/play_menu.gd:488
msgid "Code"
msgstr "Kod"

#: scenes/play/play_menu.gd:496 scenes/play/play_menu.gd:623
msgid "Join"
msgstr "Dołącz"

#. Menu button: quick match against a random online player.
#: scenes/play/play_menu.gd:533
msgid "Play with someone online"
msgstr "Graj z kimś online"

#. Small print under "Play with someone online".
#: scenes/play/play_menu.gd:538 scenes/play/play_menu.gd:647
msgid "Standard rules, about a minute per move"
msgstr "Zasady standardowe, około minuty na ruch"

#: scenes/play/play_menu.gd:539 scenes/play/play_menu.gd:559
msgid "Play with a friend"
msgstr "Graj ze znajomym"

#: scenes/play/play_menu.gd:560
msgid "One of you creates a code, the other enters it. It works between phones, tablets and computers."
msgstr "Jedno z was tworzy kod, drugie go wpisuje. Działa między telefonami, tabletami i komputerami."

#: scenes/play/play_menu.gd:563 scenes/play/play_menu.gd:607
msgid "Enter a code"
msgstr "Wpisz kod"

#: scenes/play/play_menu.gd:571
msgid "Your code"
msgstr "Twój kod"

#: scenes/play/play_menu.gd:573 scenes/play/play_menu.gd:653
msgid "Connecting…"
msgstr "Łączenie…"

#: scenes/play/play_menu.gd:576
msgid "Send this code to your friend. The game starts when they enter it."
msgstr "Wyślij ten kod znajomemu. Gra zacznie się, gdy go wpisze."

#: scenes/play/play_menu.gd:579
msgid "Share"
msgstr "Udostępnij"

#: scenes/play/play_menu.gd:581
msgid "Copy"
msgstr "Kopiuj"

#. Toast after copying the game code.
#: scenes/play/play_menu.gd:584 scenes/play/play_menu.gd:603
msgid "Copied"
msgstr "Skopiowano"

#. Message sent with the system share sheet. %s is a code like TG-7KQ2.
#: scenes/play/play_menu.gd:597
#, c-format
msgid "Play with me in Timeless Games! My game code is %s."
msgstr "Zagraj ze mną w Timeless Games! Mój kod gry to %s."

#. Quick match found no one after about a minute.
#: scenes/play/play_menu.gd:633
msgid "No one is free right now"
msgstr "Nikt nie jest teraz wolny"

#: scenes/play/play_menu.gd:634
msgid "We can keep looking while you play."
msgstr "Możemy szukać dalej, kiedy grasz."

#: scenes/play/play_menu.gd:635
msgid "Play against the AI while we keep looking"
msgstr "Graj przeciwko SI, a my poszukamy"

#: scenes/play/play_menu.gd:638
msgid "Keep searching"
msgstr "Szukaj dalej"

#: scenes/play/play_menu.gd:639
msgid "Invite a friend instead"
msgstr "Zaproś znajomego"

#. Title over a message saying why a game with another player couldn't start.
#: scenes/play/play_menu.gd:659
msgid "Couldn't start the game"
msgstr "Nie udało się rozpocząć gry"

#: scenes/play/play_menu.gd:662
msgid "OK"
msgstr "OK"

#. Asked before leaving a game against another player that's still going.
#: scenes/play/play_menu.gd:670
msgid "Leave this game?"
msgstr "Opuścić tę grę?"

#: scenes/play/play_menu.gd:671
msgid "It counts as a loss."
msgstr "Liczy się to jako porażka."

#: scenes/play/play_menu.gd:672
msgid "Leave"
msgstr "Opuść"

#. Button: don't leave the game against another player.
#: scenes/play/play_menu.gd:678
msgid "Stay"
msgstr "Zostań"

#. Heading over the list of books and articles at the end of "Game origins".
#: scenes/play/play_menu.gd:703
msgid "Sources"
msgstr "Źródła"

#: scenes/play/play_menu.gd:749
msgid "Offer a draw"
msgstr "Zaproponuj remis"

#. In-game menu button: end this game and go back to the main menu.
#: scenes/play/play_menu.gd:789
msgid "Quit to main menu"
msgstr "Wyjdź do menu głównego"

#. Menu label: the visual style of board and pieces (a noun, not "to look"). Keep it short.
#: scenes/play/play_menu.gd:831
msgid "Look"
msgstr "Wygląd"

#. Settings label next to an on/off switch and a volume slider: the game's sound effects (pieces, end of game). Keep it short.
#: scenes/play/play_menu.gd:834
msgid "Sound"
msgstr "Dźwięk"

#. Settings label next to an on/off switch and a volume slider: the game's music. Keep it short.
#: scenes/play/play_menu.gd:836
msgid "Music"
msgstr "Muzyka"

#. Title of the screen offering the other looks (styles of board and pieces) for a short video.
#: scenes/play/play_menu.gd:846
msgid "More looks"
msgstr "Inne wersje wyglądu"

#. On the "More looks" screen. The video is an ad; "until you close the game" means until the app is closed.
#: scenes/play/play_menu.gd:848
msgid "Watch a short video to switch looks until you close the game."
msgstr "Obejrzyj krótki film, aby zmieniać wygląd aż do zamknięcia aplikacji."

#. On the "More looks" screen when no video could be loaded (offline, or none available).
#: scenes/play/play_menu.gd:852
msgid "No video is ready right now. Try again in a moment."
msgstr "Teraz nie ma żadnego filmu. Spróbuj ponownie za chwilę."

#. Button: play a short video (an ad) to open the other looks.
#: scenes/play/play_menu.gd:855
msgid "Watch a video"
msgstr "Obejrzyj film"

#. On the "More looks" screen, above the Remove ads button: buying it opens every look permanently.
#: scenes/play/play_menu.gd:871
msgid "Or remove ads to keep every look for good."
msgstr "Albo usuń reklamy, aby zachować każdy wygląd na zawsze."

#. Button: buy "Remove ads" (no more ads, and every look of the board open for good). %s is the store's price, e.g. "US$1.99". Keep it short.
#: scenes/play/play_menu.gd:872 scenes/play/play_menu.gd:886 tools/smoke_greybox.gd:217
#, c-format
msgid "Remove ads · %s"
msgstr "Usuń reklamy · %s"

#. In-game menu button: get back a purchase made before with the same store account (a new phone, a reinstall). The usual store wording. Shares a row with "Privacy choices".
#: scenes/play/play_menu.gd:892 tools/smoke_greybox.gd:226
msgid "Restore purchases"
msgstr "Przywróć zakupy"

#. In-game menu button: shows Google's consent form again, to change the choice about ads and personal data.
#: scenes/play/play_menu.gd:896
msgid "Privacy choices"
msgstr "Ustawienia prywatności"

#. Message after buying "Remove ads": thanks, no more ads, and every look (style of board and pieces) is theirs.
#: scenes/play/play_menu.gd:915
msgid "Thank you! Ads are off and every look is yours."
msgstr "Dziękujemy! Reklamy są wyłączone, a każdy wygląd jest Twój."

#. Message when the store holds the payment for "Remove ads" (e.g. paying in cash, or a parent must approve).
#: scenes/play/play_menu.gd:925
msgid "Your payment is pending. Ads will turn off as soon as it goes through."
msgstr "Płatność oczekuje na realizację. Reklamy znikną, gdy tylko zostanie zaksięgowana."

#. Message when buying "Remove ads" failed (not when the player cancelled).
#: scenes/play/play_menu.gd:928
msgid "The purchase didn't go through. Please try again later."
msgstr "Zakup się nie powiódł. Spróbuj ponownie później."

#. Message after "Restore purchases" found Remove ads.
#: scenes/play/play_menu.gd:938
msgid "Your purchase is restored."
msgstr "Zakup został przywrócony."

#. Message after "Restore purchases" found nothing bought with this store account.
#: scenes/play/play_menu.gd:941
msgid "No purchase to restore on this account."
msgstr "Na tym koncie nie ma zakupów do przywrócenia."

#. Message when the store (Google Play, the App Store) can't be reached.
#: scenes/play/play_menu.gd:944
msgid "The store isn't available right now."
msgstr "Sklep jest teraz niedostępny."

#. Settings label next to a list: the graphics quality (Auto, High, Medium, Low). Keep it short.
#: scenes/play/play_menu.gd:966
msgid "Graphics"
msgstr "Grafika"

#. Followed by this player's name as others see it, e.g. "Your name: Potter 4821".
#: scenes/play/play_menu.gd:1047
#, c-format
msgid "Your name: %s"
msgstr "Twoja nazwa: %s"

#. Shown, with animated dots, while waiting for the other player to join.
#: scenes/play/play_menu.gd:1084
msgid "Waiting"
msgstr "Czekamy"

#: scenes/play/play_text.gd:24
msgid "Scribe"
msgstr "Skryba"

#: scenes/play/play_text.gd:26
msgid "Traveller"
msgstr "Wędrowiec"

#: scenes/play/play_text.gd:28
msgid "Potter"
msgstr "Garncarz"

#: scenes/play/play_text.gd:30 tools/smoke_multiplayer.gd:285
msgid "Weaver"
msgstr "Tkacz"

#: scenes/play/play_text.gd:32
msgid "Shepherd"
msgstr "Pasterz"

#: scenes/play/play_text.gd:34
msgid "Boatman"
msgstr "Przewoźnik"

#: scenes/play/play_text.gd:36
msgid "Gardener"
msgstr "Ogrodnik"

#: scenes/play/play_text.gd:38
msgid "Builder"
msgstr "Budowniczy"

#: scenes/play/play_text.gd:46
msgid "Can't reach the online service. Check your connection and try again."
msgstr "Brak połączenia z usługą online. Sprawdź połączenie i spróbuj ponownie."

#: scenes/play/play_text.gd:48
msgid "No game has that code. Check it and try again."
msgstr "Żadna gra nie ma tego kodu. Sprawdź go i spróbuj ponownie."

#: scenes/play/play_text.gd:50
msgid "That game has already started."
msgstr "Ta gra już się zaczęła."

#: scenes/play/play_text.gd:52
msgid "Couldn't connect to the other device."
msgstr "Nie udało się połączyć z drugim urządzeniem."

#: scenes/play/play_text.gd:54
msgid "The other device has a different version of the game. Update both and try again."
msgstr "Drugie urządzenie ma inną wersję gry. Zaktualizuj obie i spróbuj ponownie."

#: scenes/play/play_text.gd:56
msgid "The other device is playing a different game."
msgstr "Drugie urządzenie gra w inną grę."

#: scenes/play/play_text.gd:58
msgid "The other device uses rules this version doesn't have."
msgstr "Drugie urządzenie używa zasad, których ta wersja nie ma."

#: scenes/play/play_text.gd:60
msgid "Couldn't start a game on this network. Close any other copy of the game and try again."
msgstr "Nie udało się utworzyć gry w tej sieci. Zamknij inne kopie gry i spróbuj ponownie."

#: scenes/play/play_text.gd:62
msgid "Local play needs permission to find devices on your network."
msgstr "Gra lokalna wymaga zgody na wyszukiwanie urządzeń w twojej sieci."

#: scenes/play/play_text.gd:64
msgid "That code isn't valid. Check it and try again."
msgstr "Ten kod jest nieprawidłowy. Sprawdź go i spróbuj ponownie."

#: scenes/play/play_text.gd:66
msgid "This device isn't on a Wi-Fi network."
msgstr "To urządzenie nie jest w sieci Wi-Fi."

#: scenes/play/play_text.gd:67
msgid "Something went wrong. Please try again."
msgstr "Coś poszło nie tak. Spróbuj ponownie."

#: scenes/play/play_text.gd:75 tools/smoke_multiplayer.gd:156
msgid "You resigned."
msgstr "Poddano partię."

#: scenes/play/play_text.gd:75
msgid "Your opponent resigned."
msgstr "Przeciwnik się poddał."

#: scenes/play/play_text.gd:77
msgid "You agreed to a draw."
msgstr "Uzgodniliście remis."

#: scenes/play/play_text.gd:79
msgid "You ran out of time three times."
