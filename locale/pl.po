#: scenes/greybox/hud.gd:138
msgid "Menu"
msgstr "Menu"

#: scenes/greybox/hud.gd:161
msgid "Undo"
msgstr "Cofnij"

#. Button: end a chain of captures after the current jump.
#: scenes/greybox/hud.gd:229
msgid "Stop here"
msgstr "Zatrzymaj się"

#. Title of the list of moves played so far.
#: scenes/greybox/hud.gd:247
msgid "Moves"
msgstr "Ruchy"

#. Button after a game against another player: play them again (sides swap).
#: scenes/greybox/hud.gd:298 scenes/greybox/hud.gd:454
msgid "Play again"
msgstr "Zagraj ponownie"

#. Button after an online quick match: look for someone else to play.
#: scenes/greybox/hud.gd:308
msgid "New opponent"
msgstr "Nowy przeciwnik"

#. Button on the game-over card: back to the main menu.
#: scenes/greybox/hud.gd:314
msgid "Main menu"
msgstr "Menu główne"

#. Button on the game-over card: close it to look at the final position.
#: scenes/greybox/hud.gd:318
msgid "Look at the board"
msgstr "Obejrzyj planszę"

#. The AI is choosing its move. Shown after the turn banner, followed by animated dots.
#: scenes/greybox/hud.gd:360
msgid "thinking"
msgstr "myśli"

#: scenes/greybox/hud.gd:393 scenes/greybox/hud.gd:442
msgid "A draw"
msgstr "Remis"

#. Pieces captured so far / captures needed to win.
#: scenes/greybox/hud.gd:400
#, c-format
msgid "Captured %d / %d"
msgstr "Zbite: %d / %d"

#: scenes/greybox/hud.gd:428
msgid "No moves yet"
msgstr "Brak ruchów"

#. Small line above the result when one player is on this device.
#: scenes/greybox/hud.gd:448 tools/smoke_multiplayer.gd:285
msgid "You won"
msgstr "Wygrywasz"

#. Small line above the result when one player is on this device.
#: scenes/greybox/hud.gd:448 tools/smoke_multiplayer.gd:154
msgid "You lost"
msgstr "Przegrywasz"

#. Button after a game against another player: play them again (sides swap).
#: scenes/greybox/hud.gd:454 tools/smoke_multiplayer.gd:156
msgid "Rematch"
msgstr "Rewanż"

#. Move list entry for putting a goat on the board. %s is a point name such as c3.
#: scenes/greybox/hud.gd:464
#, c-format
msgid "place %s"
msgstr "postawienie na %s"

#: scenes/greybox/hud.gd:473
msgid "Watching the AI play both sides."
msgstr "SI gra obiema stronami."

#: scenes/greybox/hud.gd:477
msgid "Waiting for your opponent's move."
msgstr "Czekamy na ruch przeciwnika."

#: scenes/greybox/hud.gd:479
msgid "Capture chain: pick the next landing, or stop here."
msgstr "Seria bić: wybierz następny skok albo zatrzymaj się."

#: scenes/greybox/hud.gd:485
msgid "Pick where it goes. A broken ring marks a capture."
msgstr "Wybierz, dokąd idzie. Przerwany pierścień oznacza bicie."

#: scenes/greybox/hud.gd:486
msgid "Pick where it goes."
msgstr "Wybierz, dokąd idzie."

#: scenes/greybox/tutorial.gd:76
msgid "Close"
msgstr "Zamknij"

#. Button: play this step of the walkthrough again.
#: scenes/greybox/tutorial.gd:80
msgid "Replay"
msgstr "Powtórz"

#: scenes/greybox/tutorial.gd:83
msgid "‹ Back"
msgstr "‹ Wstecz"

#. Step counter in the walkthrough: step number and number of steps.
#: scenes/greybox/tutorial.gd:159
#, c-format
msgid "How to play · %d of %d"
msgstr "Jak grać · %d z %d"

#: scenes/greybox/tutorial.gd:162
msgid "Start playing"
msgstr "Zacznij grać"

#: scenes/greybox/tutorial.gd:162
msgid "Next ›"
msgstr "Dalej ›"

#. A small line over the board while the game keeps looking for an online opponent in the background.
#. Quick match is searching for an online opponent.
#: scenes/play/match_ui.gd:92 scenes/play/play_menu.gd:601
msgid "Looking for an opponent…"
msgstr "Szukamy przeciwnika…"

#. Button: stop looking for an online opponent.
#: scenes/play/match_ui.gd:95
msgid "Stop looking"
msgstr "Przestań szukać"

#. Button on "Opponent ready — play now?": leave the AI game (it's saved) and start the online game.
#: scenes/play/match_ui.gd:126
msgid "Play now"
msgstr "Graj teraz"

#. Button on "Opponent ready — play now?": keep playing the AI and stop looking.
#: scenes/play/match_ui.gd:133
msgid "Not now"
msgstr "Nie teraz"

#. The connection to the other player dropped. %d is the seconds left before the game is given up.
#: scenes/play/match_ui.gd:229
#, c-format
msgid "Reconnecting… %d s"
msgstr "Ponowne łączenie… %d s"

#. The other player's device can no longer be reached.
#: scenes/play/match_ui.gd:233
msgid "Disconnected"
msgstr "Rozłączono"

#. A quick-match opponent was found while the player plays the AI. Short: it sits over the board with two buttons.
#: scenes/play/match_ui.gd:261
msgid "Opponent ready — play now?"
msgstr "Przeciwnik gotowy — grasz teraz?"

#: scenes/play/match_ui.gd:271
msgid "Your opponent offers a draw."
msgstr "Przeciwnik proponuje remis."

#: scenes/play/match_ui.gd:271 scenes/play/match_ui.gd:277
msgid "Accept"
msgstr "Przyjmij"

#: scenes/play/match_ui.gd:271 scenes/play/match_ui.gd:277
msgid "Decline"
msgstr "Odrzuć"

#: scenes/play/match_ui.gd:274
msgid "Your opponent asks to take back their last move."
msgstr "Przeciwnik prosi o cofnięcie ostatniego ruchu."

#: scenes/play/match_ui.gd:274
msgid "Allow"
msgstr "Zgódź się"

#: scenes/play/match_ui.gd:274
msgid "Refuse"
msgstr "Odmów"

#: scenes/play/match_ui.gd:277
msgid "Your opponent wants a rematch."
msgstr "Przeciwnik chce rewanżu."

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:284
msgid "Resign this game?"
msgstr "Poddać tę partię?"

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:284 scenes/play/play_menu.gd:660
msgid "Resign"
msgstr "Poddaj się"

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:284
msgid "Keep playing"
msgstr "Graj dalej"

#: scenes/play/play_controller.gd:272
msgid "We'll let you know when an opponent is ready."
msgstr "Damy znać, gdy przeciwnik będzie gotowy."

#: scenes/play/play_controller.gd:306
msgid "Draw offered. Waiting for an answer."
msgstr "Zaproponowano remis. Czekamy na odpowiedź."

#: scenes/play/play_controller.gd:312
msgid "Asked to take back your last move."
msgstr "Wysłano prośbę o cofnięcie ostatniego ruchu."

#: scenes/play/play_controller.gd:323
msgid "Rematch offered. Waiting for an answer."
msgstr "Zaproponowano rewanż. Czekamy na odpowiedź."

#: scenes/play/play_controller.gd:325 scenes/play/play_controller.gd:421 scenes/play/play_text.gd:81 tools/smoke_multiplayer.gd:284
msgid "Your opponent left the game."
msgstr "Przeciwnik opuścił grę."

#: scenes/play/play_controller.gd:418
msgid "Reconnected."
msgstr "Połączono ponownie."

#: scenes/play/play_controller.gd:426 tools/smoke_multiplayer.gd:145
msgid "Your opponent declined the draw."
msgstr "Przeciwnik odrzucił remis."

#: scenes/play/play_controller.gd:428 tools/smoke_multiplayer.gd:237
msgid "Move taken back."
msgstr "Ruch cofnięty."

#: scenes/play/play_controller.gd:428
msgid "Your opponent said no to taking back the move."
msgstr "Przeciwnik nie zgodził się na cofnięcie ruchu."

#: scenes/play/play_controller.gd:429
msgid "Your opponent declined the rematch."
msgstr "Przeciwnik odrzucił rewanż."

#. Shown when a game with another player starts. %s is their name, e.g. "Scribe 4821".
#: scenes/play/play_controller.gd:446
#, c-format
msgid "Playing against %s"
msgstr "Twój przeciwnik: %s"

#: scenes/play/play_controller.gd:456
msgid "The other player didn't connect. Still looking…"
msgstr "Drugi gracz się nie połączył. Szukamy dalej…"

#. The turn clock in online quick match ran out. %d is 1 or 2; at 3 the game is lost.
#: scenes/play/play_controller.gd:505
#, c-format
msgid "Time ran out, so a move was played for you (%d of 3)."
msgstr "Czas minął, wykonano ruch za ciebie (%d z 3)."

#: scenes/play/play_menu.gd:231
msgid "Back"
msgstr "Wstecz"

#: scenes/play/play_menu.gd:286
msgid "Rules"
msgstr "Zasady"

#: scenes/play/play_menu.gd:305
msgid "Language"
msgstr "Język"

#. Menu button: go back to the game that was set aside.
#: scenes/play/play_menu.gd:331 scenes/play/play_menu.gd:644
msgid "Continue"
msgstr "Kontynuuj"

#: scenes/play/play_menu.gd:332 scenes/play/play_menu.gd:355
msgid "Play against the AI"
msgstr "Graj przeciwko SI"

#. Menu button: two people share this device and take turns.
#: scenes/play/play_menu.gd:334 scenes/play/play_menu.gd:375
msgid "Pass and play"
msgstr "We dwoje na jednym urządzeniu"

#. Menu button: play with someone on the same Wi-Fi network (each on their own device).
#: scenes/play/play_menu.gd:336 scenes/play/play_menu.gd:384
msgid "Play local"
msgstr "Graj lokalnie"

#: scenes/play/play_menu.gd:338 scenes/play/play_menu.gd:487
msgid "Play online"
msgstr "Graj online"

#: scenes/play/play_menu.gd:339 tests/test_localization.gd:14
msgid "How to play"
msgstr "Jak grać"

#. Main menu button: close the game completely.
#: scenes/play/play_menu.gd:346
msgid "Quit game"
msgstr "Wyjdź z gry"

#: scenes/play/play_menu.gd:359
msgid "Novice"
msgstr "Nowicjusz"

#: scenes/play/play_menu.gd:359
msgid "Apprentice"
msgstr "Uczeń"

#: scenes/play/play_menu.gd:359
msgid "Adept"
msgstr "Znawca"

#: scenes/play/play_menu.gd:359
msgid "Master"
msgstr "Mistrz"

#. Menu label: how strong the computer opponent is.
#. Shown instead of a player's name when it can't be read.
#: scenes/play/play_menu.gd:364 scenes/play/play_text.gd:15
msgid "Opponent"
msgstr "Przeciwnik"

#: scenes/play/play_menu.gd:367 scenes/play/play_menu.gd:379 scenes/play/play_menu.gd:403
msgid "Start"
msgstr "Zacznij"

#: scenes/play/play_menu.gd:376
msgid "Two players share this device and take turns."
msgstr "Dwóch graczy dzieli to urządzenie i gra na zmianę."

#: scenes/play/play_menu.gd:385
msgid "Both devices need to be on the same Wi-Fi."
msgstr "Oba urządzenia muszą być w tej samej sieci Wi-Fi."

#. Menu button: start a game that another device on the same Wi-Fi can join.
#: scenes/play/play_menu.gd:388 scenes/play/play_menu.gd:399
msgid "Host a game"
msgstr "Utwórz grę"

#. Menu button: join a game another device on the same Wi-Fi is hosting.
#: scenes/play/play_menu.gd:390 scenes/play/play_menu.gd:431
msgid "Join a game"
msgstr "Dołącz do gry"

#: scenes/play/play_menu.gd:399 scenes/play/play_menu.gd:518
msgid "Create a code"
msgstr "Utwórz kod"

#: scenes/play/play_menu.gd:417
msgid "Waiting for a player"
msgstr "Czekamy na gracza"

#: scenes/play/play_menu.gd:418
msgid "On the other device, choose Play local, then Join a game."
msgstr "Na drugim urządzeniu wybierz Graj lokalnie, a potem Dołącz do gry."

#. Above a code like 7KQ-2M4P that the other player can type to join.
#: scenes/play/play_menu.gd:422
msgid "If the game doesn't appear there, enter this code"
msgstr "Jeśli gra się tam nie pojawi, wpisz ten kod"

#: scenes/play/play_menu.gd:427 scenes/play/play_menu.gd:547 scenes/play/play_menu.gd:598 scenes/play/play_menu.gd:605 scenes/play/play_menu.gd:610
msgid "Cancel"
msgstr "Anuluj"

#. Shown while listening for games hosted on the same Wi-Fi; a list of games appears below.
#: scenes/play/play_menu.gd:433
msgid "Looking for games on this Wi-Fi…"
msgstr "Szukamy gier w tej sieci Wi-Fi…"

#. Placeholder in the box for typing a nearby game's code.
#: scenes/play/play_menu.gd:444
msgid "Code"
msgstr "Kod"

#: scenes/play/play_menu.gd:452 scenes/play/play_menu.gd:579
msgid "Join"
msgstr "Dołącz"

#. Menu button: quick match against a random online player.
#: scenes/play/play_menu.gd:489
msgid "Play with someone online"
msgstr "Graj z kimś online"

#. Small print under "Play with someone online".
#: scenes/play/play_menu.gd:494 scenes/play/play_menu.gd:603
msgid "Standard rules, about a minute per move"
msgstr "Zasady standardowe, około minuty na ruch"

#: scenes/play/play_menu.gd:495 scenes/play/play_menu.gd:515
msgid "Play with a friend"
msgstr "Graj ze znajomym"

#: scenes/play/play_menu.gd:516
msgid "One of you creates a code, the other enters it. It works between phones, tablets and computers."
msgstr "Jedno z was tworzy kod, drugie go wpisuje. Działa między telefonami, tabletami i komputerami."

#: scenes/play/play_menu.gd:519 scenes/play/play_menu.gd:563
msgid "Enter a code"
msgstr "Wpisz kod"

#: scenes/play/play_menu.gd:527
msgid "Your code"
msgstr "Twój kod"

#: scenes/play/play_menu.gd:529 scenes/play/play_menu.gd:609
msgid "Connecting…"
msgstr "Łączenie…"

#: scenes/play/play_menu.gd:532
msgid "Send this code to your friend. The game starts when they enter it."
msgstr "Wyślij ten kod znajomemu. Gra zacznie się, gdy go wpisze."

#: scenes/play/play_menu.gd:535
msgid "Share"
msgstr "Udostępnij"

#: scenes/play/play_menu.gd:537
msgid "Copy"
msgstr "Kopiuj"

#. Toast after copying the game code.
#: scenes/play/play_menu.gd:540 scenes/play/play_menu.gd:559
msgid "Copied"
msgstr "Skopiowano"

#. Message sent with the system share sheet. %s is a code like TG-7KQ2.
#: scenes/play/play_menu.gd:553
#, c-format
msgid "Play with me in Timeless Games! My game code is %s."
msgstr "Zagraj ze mną w Timeless Games! Mój kod gry to %s."

#. Quick match found no one after about a minute.
#: scenes/play/play_menu.gd:589
msgid "No one is free right now"
msgstr "Nikt nie jest teraz wolny"

#: scenes/play/play_menu.gd:590
msgid "We can keep looking while you play."
msgstr "Możemy szukać dalej, kiedy grasz."

#: scenes/play/play_menu.gd:591
msgid "Play against the AI while we keep looking"
msgstr "Graj przeciwko SI, a my poszukamy"

#: scenes/play/play_menu.gd:594
msgid "Keep searching"
msgstr "Szukaj dalej"

#: scenes/play/play_menu.gd:595
msgid "Invite a friend instead"
msgstr "Zaproś znajomego"

#. Title over a message saying why a game with another player couldn't start.
#: scenes/play/play_menu.gd:615
msgid "Couldn't start the game"
msgstr "Nie udało się rozpocząć gry"

#: scenes/play/play_menu.gd:618
msgid "OK"
msgstr "OK"

#. Asked before leaving a game against another player that's still going.
#: scenes/play/play_menu.gd:626
msgid "Leave this game?"
msgstr "Opuścić tę grę?"

#: scenes/play/play_menu.gd:627
msgid "It counts as a loss."
msgstr "Liczy się to jako porażka."

#: scenes/play/play_menu.gd:628
msgid "Leave"
msgstr "Opuść"

#. Button: don't leave the game against another player.
#: scenes/play/play_menu.gd:634
msgid "Stay"
msgstr "Zostań"

#: scenes/play/play_menu.gd:650
msgid "Offer a draw"
msgstr "Zaproponuj remis"

#: scenes/play/play_menu.gd:655
msgid "Ask to undo"
msgstr "Poproś o cofnięcie"

#. Menu label: the visual style of board and pieces (a noun, not "to look"). Keep it short.
#: scenes/play/play_menu.gd:675
msgid "Look"
msgstr "Wygląd"

#. In-game menu button: end this game and go back to the main menu.
#: scenes/play/play_menu.gd:679
msgid "Quit to main menu"
msgstr "Wyjdź do menu głównego"

#. Followed by this player's name as others see it, e.g. "Your name: Potter 4821".
#: scenes/play/play_menu.gd:724
#, c-format
msgid "Your name: %s"
msgstr "Twoja nazwa: %s"

#. Shown, with animated dots, while waiting for the other player to join.
#: scenes/play/play_menu.gd:761
msgid "Waiting"
msgstr "Czekamy"

#: scenes/play/play_text.gd:24
msgid "Scribe"
msgstr "Skryba"

#: scenes/play/play_text.gd:26
msgid "Traveller"
msgstr "Wędrowiec"

#: scenes/play/play_text.gd:28
msgid "Potter"
msgstr "Garncarz"

#: scenes/play/play_text.gd:30 tools/smoke_multiplayer.gd:268
msgid "Weaver"
msgstr "Tkacz"

#: scenes/play/play_text.gd:32
msgid "Shepherd"
msgstr "Pasterz"

#: scenes/play/play_text.gd:34
msgid "Boatman"
msgstr "Przewoźnik"

#: scenes/play/play_text.gd:36
msgid "Gardener"
msgstr "Ogrodnik"

#: scenes/play/play_text.gd:38
msgid "Builder"
msgstr "Budowniczy"

#: scenes/play/play_text.gd:46
msgid "Can't reach the online service. Check your connection and try again."
msgstr "Brak połączenia z usługą online. Sprawdź połączenie i spróbuj ponownie."

#: scenes/play/play_text.gd:48
msgid "No game has that code. Check it and try again."
msgstr "Żadna gra nie ma tego kodu. Sprawdź go i spróbuj ponownie."

#: scenes/play/play_text.gd:50
msgid "That game has already started."
msgstr "Ta gra już się zaczęła."

#: scenes/play/play_text.gd:52
msgid "Couldn't connect to the other device."
msgstr "Nie udało się połączyć z drugim urządzeniem."

#: scenes/play/play_text.gd:54
msgid "The other device has a different version of the game. Update both and try again."
msgstr "Drugie urządzenie ma inną wersję gry. Zaktualizuj obie i spróbuj ponownie."

#: scenes/play/play_text.gd:56
msgid "The other device is playing a different game."
msgstr "Drugie urządzenie gra w inną grę."

#: scenes/play/play_text.gd:58
msgid "The other device uses rules this version doesn't have."
msgstr "Drugie urządzenie używa zasad, których ta wersja nie ma."

#: scenes/play/play_text.gd:60
msgid "Couldn't start a game on this network. Close any other copy of the game and try again."
msgstr "Nie udało się utworzyć gry w tej sieci. Zamknij inne kopie gry i spróbuj ponownie."

#: scenes/play/play_text.gd:62
msgid "Local play needs permission to find devices on your network."
msgstr "Gra lokalna wymaga zgody na wyszukiwanie urządzeń w twojej sieci."

#: scenes/play/play_text.gd:64
msgid "That code isn't valid. Check it and try again."
msgstr "Ten kod jest nieprawidłowy. Sprawdź go i spróbuj ponownie."

#: scenes/play/play_text.gd:66
msgid "This device isn't on a Wi-Fi network."
msgstr "To urządzenie nie jest w sieci Wi-Fi."

#: scenes/play/play_text.gd:67
msgid "Something went wrong. Please try again."
msgstr "Coś poszło nie tak. Spróbuj ponownie."

#: scenes/play/play_text.gd:75 tools/smoke_multiplayer.gd:155
msgid "You resigned."
msgstr "Poddano partię."

#: scenes/play/play_text.gd:75
msgid "Your opponent resigned."
msgstr "Przeciwnik się poddał."

#: scenes/play/play_text.gd:77
msgid "You agreed to a draw."
msgstr "Uzgodniliście remis."

#: scenes/play/play_text.gd:79
msgid "You ran out of time three times."
msgstr "Trzy razy skończył ci się czas."

#: scenes/play/play_text.gd:79
msgid "Your opponent ran out of time three times."
msgstr "Przeciwnikowi trzy razy skończył się czas."

#: scenes/play/play_text.gd:81
msgid "You left the game."
msgstr "Opuszczono grę."

#: scenes/play/play_text.gd:83
msgid "The other device sent moves that aren't allowed."
msgstr "Drugie urządzenie wysłało niedozwolone ruchy."

#: tests/test_localization.gd:13 titles/common/hunt_text.gd:53
msgid "Goats to move"
msgstr "Ruch kóz"

#. Goats not yet put on the board. A "Remaining: %d" style is fine where it reads better.
#: tests/test_localization.gd:15 titles/common/hunt_text.gd:108
#, c-format
msgid "%d goat still to place"
msgid_plural "%d goats still to place"
msgstr[0] "Kozy do postawienia: %d"
msgstr[1] "Kozy do postawienia: %d"
msgstr[2] "Kozy do postawienia: %d"

#: titles/bagh_chal/art/brass_style.gd:38
msgid "Temple brass"
msgstr "Mosiądz świątynny"

#: titles/bagh_chal/art/brass_style.gd:39
msgid "An engraved brass board and cast figures, at dusk in a temple courtyard."
msgstr "Grawerowana mosiężna plansza i odlewane figurki o zmierzchu na dziedzińcu świątyni."

#: titles/bagh_chal/art/stone_style.gd:38
msgid "Stone and pebbles"
msgstr "Kamień i kamyki"

#: titles/bagh_chal/art/stone_style.gd:39
msgid "The historical way: lines cut into stone and chalked, tigers and goats of river stone, on a straw mat."
msgstr "Po dawnemu: linie wykute w kamieniu i potarte kredą, tygrysy i kozy z rzecznych kamieni, na słomianej macie."

#. Subtitle under the game name: which rule set is being played.
#: titles/common/hunt_text.gd:26
msgid "Standard rules"
msgstr "Zasady standardowe"

#: titles/common/hunt_text.gd:28
msgid "Parlett 1976: hunt to the last goat"
msgstr "Parlett 1976: polowanie do ostatniej kozy"

#: titles/common/hunt_text.gd:30
msgid "Adugo, the Bororo rules"
msgstr "Adugo, zasady Bororo"

#. Komikan is a game of the Mapuche people (Chile, Argentina); our rules are a reconstruction from old written accounts.
#: titles/common/hunt_text.gd:33
msgid "Komikan, a Mapuche reconstruction"
msgstr "Komikan, rekonstrukcja gry Mapuczów"

#: titles/common/hunt_text.gd:40
msgid "Bagh Chal · Standard"
msgstr "Bagh Chal · Standard"

#: titles/common/hunt_text.gd:42
msgid "Bagh Chal · Parlett 1976"
msgstr "Bagh Chal · Parlett 1976"

#: titles/common/hunt_text.gd:44
msgid "Jogo da Onça · Adugo"
msgstr "Jogo da Onça · Adugo"

#: titles/common/hunt_text.gd:46
msgid "Jogo da Onça · Komikan"
msgstr "Jogo da Onça · Komikan"

#: titles/common/hunt_text.gd:53
msgid "Tigers to move"
msgstr "Ruch tygrysów"

#: titles/common/hunt_text.gd:55
msgid "Jaguar to move"
msgstr "Ruch jaguara"

#: titles/common/hunt_text.gd:55 titles/common/hunt_text.gd:57
msgid "Dogs to move"
msgstr "Ruch psów"

#: titles/common/hunt_text.gd:57
msgid "Puma to move"
msgstr "Ruch pumy"

#: titles/common/hunt_text.gd:64
msgid "The tigers won"
msgstr "Tygrysy wygrały"

#: titles/common/hunt_text.gd:64
msgid "The goats won"
msgstr "Kozy wygrały"

#: titles/common/hunt_text.gd:66
msgid "The jaguar won"
msgstr "Jaguar wygrał"

#: titles/common/hunt_text.gd:66 titles/common/hunt_text.gd:68
msgid "The dogs won"
msgstr "Psy wygrały"

#: titles/common/hunt_text.gd:68
msgid "The puma won"
msgstr "Puma wygrała"

#: titles/common/hunt_text.gd:75
msgid "The tigers win"
msgstr "Wygrywają tygrysy"

#: titles/common/hunt_text.gd:75
msgid "The goats win"
msgstr "Wygrywają kozy"

#: titles/common/hunt_text.gd:77
msgid "The jaguar wins"
msgstr "Wygrywa jaguar"

#: titles/common/hunt_text.gd:77 titles/common/hunt_text.gd:79
msgid "The dogs win"
msgstr "Wygrywają psy"

#: titles/common/hunt_text.gd:79
msgid "The puma wins"
msgstr "Wygrywa puma"

#: titles/common/hunt_text.gd:85
msgid "You play the tigers"
msgstr "Grasz tygrysami"

#: titles/common/hunt_text.gd:85
msgid "You play the goats"
msgstr "Grasz kozami"

#: titles/common/hunt_text.gd:87
msgid "You play the jaguar"
msgstr "Grasz jaguarem"

#: titles/common/hunt_text.gd:87 titles/common/hunt_text.gd:89
msgid "You play the dogs"
msgstr "Grasz psami"

#: titles/common/hunt_text.gd:89
msgid "You play the puma"
msgstr "Grasz pumą"

#: titles/common/hunt_text.gd:95
msgid "Choose a tiger to move."
msgstr "Wybierz tygrysa do ruchu."

#: titles/common/hunt_text.gd:95
msgid "Choose a goat to move."
msgstr "Wybierz kozę do ruchu."

#: titles/common/hunt_text.gd:97
msgid "Move the jaguar."
msgstr "Rusz jaguara."

#: titles/common/hunt_text.gd:97 titles/common/hunt_text.gd:99
msgid "Choose a dog to move."
msgstr "Wybierz psa do ruchu."

#: titles/common/hunt_text.gd:99
msgid "Move the puma."
msgstr "Rusz pumę."

#: titles/common/hunt_text.gd:103
msgid "Place a goat on any empty point."
msgstr "Postaw kozę na dowolnym wolnym punkcie."

#. Reason for the hunter's win when it must take every piece. "Eaten" fits Komikan, whose puma "eats everything".
#: titles/common/hunt_text.gd:118
msgid "Every goat has been captured."
msgstr "Wszystkie kozy zostały zbite."

#. Reason for the hunter's win when it must take every piece. "Eaten" fits Komikan, whose puma "eats everything".
#: titles/common/hunt_text.gd:118
msgid "Every dog has been eaten."
msgstr "Wszystkie psy zostały zjedzone."

#: titles/common/hunt_text.gd:119
#, c-format
msgid "%d goat captured."
msgid_plural "%d goats captured."
msgstr[0] "Zbite kozy: %d."
msgstr[1] "Zbite kozy: %d."
msgstr[2] "Zbite kozy: %d."

#: titles/common/hunt_text.gd:120
#, c-format
msgid "%d dog captured."
msgid_plural "%d dogs captured."
msgstr[0] "Zbite psy: %d."
msgstr[1] "Zbite psy: %d."
msgstr[2] "Zbite psy: %d."

#: titles/common/hunt_text.gd:124
msgid "The tigers are trapped: none of them can move."
msgstr "Tygrysy są uwięzione: żaden nie może się ruszyć."

#: titles/common/hunt_text.gd:126
msgid "The jaguar is trapped and can't move."
msgstr "Jaguar jest uwięziony i nie może się ruszyć."

#: titles/common/hunt_text.gd:128
msgid "The puma is trapped and can't move."
msgstr "Puma jest uwięziona i nie może się ruszyć."

#: titles/common/hunt_text.gd:130
msgid "The goats can't move."
msgstr "Kozy nie mogą się ruszyć."

#: titles/common/hunt_text.gd:130
msgid "The dogs can't move any more."
msgstr "Psy nie mogą się już ruszyć."

#: titles/common/hunt_text.gd:132
msgid "Every move left would repeat an earlier position."
msgstr "Każdy pozostały ruch powtórzyłby wcześniejszą pozycję."

#: titles/common/hunt_text.gd:134
msgid "The same position came up three times."
msgstr "Ta sama pozycja wystąpiła trzy razy."

#. Reason for a draw: the tigers made this many moves in a row without a capture.
#: titles/common/hunt_text.gd:141
#, c-format
msgid "The tigers went %d move without capturing."
msgid_plural "The tigers went %d moves without capturing."
msgstr[0] "Tygrysy wykonały %d ruch bez bicia."
msgstr[1] "Tygrysy wykonały %d ruchy bez bicia."
msgstr[2] "Tygrysy wykonały %d ruchów bez bicia."

#: titles/common/hunt_text.gd:143
#, c-format
msgid "The jaguar went %d move without capturing."
msgid_plural "The jaguar went %d moves without capturing."
msgstr[0] "Jaguar wykonał %d ruch bez bicia."
msgstr[1] "Jaguar wykonał %d ruchy bez bicia."
msgstr[2] "Jaguar wykonał %d ruchów bez bicia."

#: titles/common/hunt_text.gd:145
#, c-format
msgid "The puma went %d move without capturing."
msgid_plural "The puma went %d moves without capturing."
msgstr[0] "Puma wykonała %d ruch bez bicia."
msgstr[1] "Puma wykonała %d ruchy bez bicia."
msgstr[2] "Puma wykonała %d ruchów bez bicia."

#. Count toward the draw rule: tiger moves since the last capture / the limit.
#: titles/common/hunt_text.gd:160
#, c-format
msgid "Tiger moves without capturing: %d / %d"
msgstr "Ruchy tygrysów bez bicia: %d / %d"

#: titles/common/hunt_text.gd:162
#, c-format
msgid "Jaguar moves without capturing: %d / %d"
msgstr "Ruchy jaguara bez bicia: %d / %d"

#: titles/common/hunt_text.gd:164
#, c-format
msgid "Puma moves without capturing: %d / %d"
msgstr "Ruchy pumy bez bicia: %d / %d"

#: titles/common/hunt_tutorials.gd:134
msgid "Tigers and goats"
msgstr "Tygrysy i kozy"

#: titles/common/hunt_tutorials.gd:135
msgid "Four tigers against twenty goats. The tigers start on the corners; the goats start in hand, off the board. The goats move first."
msgstr "Cztery tygrysy przeciw dwudziestu kozom. Tygrysy zaczynają w rogach; kozy czekają poza planszą. Pierwsze ruszają się kozy."

#: titles/common/hunt_tutorials.gd:140
msgid "Placing the goats"
msgstr "Stawianie kóz"

#: titles/common/hunt_tutorials.gd:141
msgid "While goats are left in hand, every goat turn is a placement: one goat onto any empty point. Goats on the board can't move until all twenty are placed. The tigers move in between."
msgstr "Dopóki zostały kozy poza planszą, każdy ruch kóz to postawienie jednej kozy na dowolnym wolnym punkcie. Kozy na planszy nie mogą się ruszać, dopóki nie zostaną postawione wszystkie dwadzieścia. W międzyczasie ruszają się tygrysy."

#: titles/common/hunt_tutorials.gd:145
msgid "How a tiger moves"
msgstr "Jak rusza się tygrys"

#: titles/common/hunt_tutorials.gd:146
msgid "A tiger steps along a line to the next empty point. Diagonals run only through every other point, so some points have eight neighbours and the rest four or fewer."
msgstr "Tygrys przechodzi wzdłuż linii na najbliższy wolny punkt. Przekątne biegną tylko przez co drugi punkt, więc niektóre punkty mają ośmiu sąsiadów, a pozostałe czterech lub mniej."

#: titles/common/hunt_tutorials.gd:153 titles/common/hunt_tutorials.gd:230 titles/common/hunt_tutorials.gd:299
msgid "Capturing"
msgstr "Bicie"

#: titles/common/hunt_tutorials.gd:154
msgid "A tiger captures by jumping over a goat next to it on a line, onto the empty point just beyond. The goat leaves the board. One goat per jump, and capturing is never compulsory."
msgstr "Tygrys bije, przeskakując nad kozą stojącą obok niego na linii na wolny punkt tuż za nią. Koza schodzi z planszy. Jedna koza na skok, a bicie nigdy nie jest obowiązkowe."

#: titles/common/hunt_tutorials.gd:160
msgid "Safety in numbers"
msgstr "W grupie bezpieczniej"

#: titles/common/hunt_tutorials.gd:161
msgid "A goat with another goat right behind it, or the edge of the board, can't be jumped: the tiger needs an empty point to land on. Goats that stay together are safe."
msgstr "Kozy, za którą stoi inna koza albo jest krawędź planszy, nie można przeskoczyć: tygrys potrzebuje wolnego punktu do lądowania. Kozy, które trzymają się razem, są bezpieczne."

#: titles/common/hunt_tutorials.gd:166
msgid "Moving the goats"
msgstr "Ruchy kóz"

#: titles/common/hunt_tutorials.gd:167
msgid "Once all the goats are in play, a goat steps along a line to the next empty point, just as a tiger does. Goats never jump and never capture."
msgstr "Gdy wszystkie kozy są w grze, koza przechodzi wzdłuż linii na najbliższy wolny punkt, tak jak tygrys. Kozy nigdy nie skaczą i nie biją."

#: titles/common/hunt_tutorials.gd:177 titles/common/hunt_tutorials.gd:186
msgid "How the tigers win"
msgstr "Jak wygrywają tygrysy"

#: titles/common/hunt_tutorials.gd:178
msgid "In Parlett's version the tigers must capture all twenty goats. Everything else is as in the standard game."
msgstr "W wersji Parletta tygrysy muszą zbić wszystkie dwadzieścia kóz. Poza tym wszystko jest jak w grze standardowej."

#: titles/common/hunt_tutorials.gd:187
msgid "The tigers win by capturing five goats."
msgstr "Tygrysy wygrywają, zbijając pięć kóz."

#: titles/common/hunt_tutorials.gd:195
msgid "How the goats win"
msgstr "Jak wygrywają kozy"

#: titles/common/hunt_tutorials.gd:196
msgid "The goats win when no tiger can move: every tiger is hemmed in by goats it can't jump."
msgstr "Kozy wygrywają, gdy żaden tygrys nie może się ruszyć: każdy jest otoczony kozami, których nie może przeskoczyć."

#. Walkthrough step title: the rules for a drawn game.
#: titles/common/hunt_tutorials.gd:204 titles/common/hunt_tutorials.gd:266 titles/common/hunt_tutorials.gd:325
msgid "Draws"
msgstr "Remisy"

#: titles/common/hunt_tutorials.gd:205
msgid "Once all the goats are placed, no move may bring back a position that has already occurred. The game is a draw if the tigers go 50 moves without capturing, or if every move left would repeat a position."
msgstr "Gdy wszystkie kozy są już na planszy, żaden ruch nie może przywrócić pozycji, która już wystąpiła. Partia kończy się remisem, jeśli tygrysy wykonają 50 ruchów bez bicia albo każdy pozostały ruch powtórzyłby pozycję."

#: titles/common/hunt_tutorials.gd:218
msgid "The jaguar and the dogs"
msgstr "Jaguar i psy"

#: titles/common/hunt_tutorials.gd:219
msgid "One jaguar against fourteen dogs. The jaguar starts in the middle of the board and the dogs fill the far half. The jaguar moves first."
msgstr "Jeden jaguar przeciw czternastu psom. Jaguar zaczyna na środku planszy, a psy zajmują przeciwną połowę. Pierwszy rusza się jaguar."

#: titles/common/hunt_tutorials.gd:224
msgid "Moving"
msgstr "Ruchy"

#: titles/common/hunt_tutorials.gd:225
msgid "Each turn, one piece steps along a line to the next empty point, in any direction. The triangle is part of the board, and either side may go in."
msgstr "W każdej turze jeden pionek przechodzi wzdłuż linii na najbliższy wolny punkt, w dowolnym kierunku. Trójkąt jest częścią planszy i obie strony mogą do niego wejść."

#: titles/common/hunt_tutorials.gd:231
msgid "The jaguar captures by jumping over a dog next to it on a line, onto the empty point just beyond. The dog leaves the board. Capturing is optional."
msgstr "Jaguar bije, przeskakując nad psem stojącym obok niego na linii na wolny punkt tuż za nim. Pies schodzi z planszy. Bicie jest dobrowolne."

#: titles/common/hunt_tutorials.gd:237
msgid "Chains of captures"
msgstr "Serie bić"

#: titles/common/hunt_tutorials.gd:238
msgid "After a capture the jaguar may jump again, and again, changing direction as it likes, and it may stop after any jump. No dog can be jumped twice in one turn."
msgstr "Po biciu jaguar może skoczyć znowu i znowu, zmieniając kierunek, jak chce, i zatrzymać się po dowolnym skoku. Żadnego psa nie można przeskoczyć dwa razy w jednej turze."

#: titles/common/hunt_tutorials.gd:244
msgid "Strength in pairs"
msgstr "Siła pary"

#: titles/common/hunt_tutorials.gd:245
msgid "Two dogs in a row along a line protect each other: the jaguar has nowhere to land."
msgstr "Dwa psy jeden za drugim na linii chronią się nawzajem: jaguar nie ma gdzie wylądować."

#: titles/common/hunt_tutorials.gd:250
msgid "How the jaguar wins"
msgstr "Jak wygrywa jaguar"

#: titles/common/hunt_tutorials.gd:251
msgid "The jaguar wins by capturing five dogs."
msgstr "Jaguar wygrywa, zbijając pięć psów."

#: titles/common/hunt_tutorials.gd:258 titles/common/hunt_tutorials.gd:306
msgid "How the dogs win"
msgstr "Jak wygrywają psy"

#: titles/common/hunt_tutorials.gd:259
msgid "The dogs win when the jaguar can't move at all."
msgstr "Psy wygrywają, gdy jaguar w ogóle nie może się ruszyć."

#: titles/common/hunt_tutorials.gd:267
msgid "If the same position comes up three times, or the jaguar goes 50 moves without capturing, the game is a draw."
msgstr "Jeśli ta sama pozycja wystąpi trzy razy albo jaguar wykona 50 ruchów bez bicia, partia kończy się remisem."

#: titles/common/hunt_tutorials.gd:278
msgid "The puma and the dogs"
msgstr "Puma i psy"

#. "The tower" is the name of Komikan's triangle in the Spanish sources ("la torre"). Use the ordinary word for tower.
#: titles/common/hunt_tutorials.gd:280
msgid "Komikan is a Mapuche hunting game. The puma starts inside the tower, the triangle, and twelve dogs wait at the far end. The puma moves first."
msgstr "Komikan to gra myśliwska Mapuczów. Puma zaczyna w wieży, czyli trójkącie, a dwanaście psów czeka na drugim końcu. Pierwsza rusza się puma."

#: titles/common/hunt_tutorials.gd:285
msgid "The puma"
msgstr "Puma"

#: titles/common/hunt_tutorials.gd:286
msgid "The puma steps along any line, in any direction, forward or back."
msgstr "Puma chodzi wzdłuż dowolnej linii, w dowolnym kierunku, do przodu i do tyłu."

#: titles/common/hunt_tutorials.gd:291
msgid "Moving the dogs"
msgstr "Ruchy psów"

#: titles/common/hunt_tutorials.gd:292
msgid "A dog steps the same way: along any line to the next empty point, forward, sideways or back. Only the puma can jump."
msgstr "Pies chodzi tak samo: wzdłuż dowolnej linii na najbliższy wolny punkt, do przodu, w bok albo do tyłu. Skakać może tylko puma."

#: titles/common/hunt_tutorials.gd:300
msgid "The puma captures by jumping over a lone dog onto the empty point beyond. It may jump again and again, changing direction, and stop after any jump. Two dogs in a row protect each other."
msgstr "Puma bije, przeskakując nad samotnym psem na wolny punkt za nim. Może skakać raz za razem, zmieniając kierunek, i zatrzymać się po dowolnym skoku. Dwa psy jeden za drugim na linii chronią się nawzajem."

#: titles/common/hunt_tutorials.gd:307
msgid "The dogs win by hemming the puma in so that it can't move."
msgstr "Psy wygrywają, osaczając pumę tak, by nie mogła się ruszyć."

#: titles/common/hunt_tutorials.gd:315
msgid "How the puma wins"
msgstr "Jak wygrywa puma"

#: titles/common/hunt_tutorials.gd:316
msgid "The puma wins as soon as it has eaten three dogs."
msgstr "Puma wygrywa, gdy tylko zje trzy psy."

#: titles/common/hunt_tutorials.gd:326
msgid "If the same position comes up three times, or the puma goes 50 moves without capturing, the game is a draw."
msgstr "Jeśli ta sama pozycja wystąpi trzy razy albo puma wykona 50 ruchów bez bicia, partia kończy się remisem."

#: titles/common/hunt_tutorials.gd:330
msgid "A reconstruction"
msgstr "Rekonstrukcja"

#. Trapial-Kuzen is the name of a modern Mapuche version of Komikan (Argentina); keep it as is.
#: titles/common/hunt_tutorials.gd:332
msgid "In the accounts written down a century ago, the dogs may only go forward, and then a puma that stays in the tower can never be caught. Here the dogs move and the puma wins as in Trapial-Kuzen, a modern Mapuche version of the game. The tower is ordinary board, and the puma moves first unless you change it in the settings."
msgstr "W relacjach spisanych sto lat temu psy mogą iść tylko do przodu, a wtedy puma, która zostaje w wieży, nigdy nie zostanie złapana. Tutaj psy chodzą, a puma wygrywa jak w Trapial-Kuzen, współczesnej mapuczeńskiej wersji gry. Wieża to zwykła część planszy, a pierwsza rusza się puma, chyba że zmienisz to w ustawieniach."
