msgstr ""
"Project-Id-Version: Timeless Games: hunt-games\n"
"Language: th\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"
"X-Translator: Claude (2026-11-06)\n"
"X-Review-Status: translation confidence moderate; native-speaker review ESSENTIAL before release (bible §7), Thai first\n"

#: scenes/greybox/hud.gd:140
msgid "Menu"
msgstr "เมนู"

#: scenes/greybox/hud.gd:164
msgid "Undo"
msgstr "ย้อนตาเดิน"

#. Button: end a chain of captures after the current jump.
#: scenes/greybox/hud.gd:235
msgid "Stop here"
msgstr "หยุดตรงนี้"

#. Title of the list of moves played so far.
#: scenes/greybox/hud.gd:254
msgid "Moves"
msgstr "การเดิน"

#. Button after a game against another player: play them again (sides swap).
#: scenes/greybox/hud.gd:305 scenes/greybox/hud.gd:484
msgid "Play again"
msgstr "เล่นอีกครั้ง"

#. Button after an online quick match: look for someone else to play.
#: scenes/greybox/hud.gd:315
msgid "New opponent"
msgstr "คู่แข่งใหม่"

#. Button on the game-over card: back to the main menu.
#: scenes/greybox/hud.gd:320
msgid "Main menu"
msgstr "เมนูหลัก"

#. Button on the game-over card: close it to look at the final position.
#: scenes/greybox/hud.gd:324
msgid "Look at the board"
msgstr "ดูกระดาน"

#. The AI is choosing its move. Shown after the turn banner, followed by animated dots.
#: scenes/greybox/hud.gd:390
msgid "thinking"
msgstr "กำลังคิด"

#: scenes/greybox/hud.gd:423 scenes/greybox/hud.gd:472
msgid "A draw"
msgstr "เสมอ"

#. Pieces captured so far / captures needed to win.
#: scenes/greybox/hud.gd:430
#, c-format
msgid "Captured %d / %d"
msgstr "กินแล้ว %d / %d"

#: scenes/greybox/hud.gd:458
msgid "No moves yet"
msgstr "ยังไม่มีการเดิน"

#. Small line above the result when one player is on this device.
#: scenes/greybox/hud.gd:478 tools/smoke_multiplayer.gd:301
msgid "You won"
msgstr "คุณชนะ"

#. Small line above the result when one player is on this device.
#: scenes/greybox/hud.gd:478 tools/smoke_multiplayer.gd:154
msgid "You lost"
msgstr "คุณแพ้"

#. Button after a game against another player: play them again (sides swap).
#: scenes/greybox/hud.gd:484 tools/smoke_multiplayer.gd:156
msgid "Rematch"
msgstr "แข่งอีกครั้ง"

#. Move list entry for putting a goat on the board. %s is a point name such as c3.
#: scenes/greybox/hud.gd:496
#, c-format
msgid "place %s"
msgstr "วางที่ %s"

#: scenes/greybox/hud.gd:505
msgid "Watching the AI play both sides."
msgstr "AI กำลังเล่นทั้งสองฝ่าย"

#: scenes/greybox/hud.gd:509
msgid "Waiting for your opponent's move."
msgstr "กำลังรอคู่แข่งเดิน"

#: scenes/greybox/hud.gd:511
msgid "Capture chain: pick the next landing, or stop here."
msgstr "กินต่อเนื่อง: เลือกจุดลงถัดไป หรือหยุดตรงนี้"

#: scenes/greybox/hud.gd:517
msgid "Pick where it goes. A broken ring marks a capture."
msgstr "เลือกจุดที่จะไป วงแหวนที่ขาดหมายถึงการกิน"

#: scenes/greybox/hud.gd:518
msgid "Pick where it goes."
msgstr "เลือกจุดที่จะไป"

#: scenes/greybox/tutorial.gd:79
msgid "Close"
msgstr "ปิด"

#. Button: play this step of the walkthrough again.
#: scenes/greybox/tutorial.gd:83
msgid "Replay"
msgstr "เล่นซ้ำ"

#: scenes/greybox/tutorial.gd:86
msgid "‹ Back"
msgstr "‹ ก่อนหน้า"

#. Step counter in the walkthrough: step number and number of steps.
#: scenes/greybox/tutorial.gd:175
#, c-format
msgid "How to play · %d of %d"
msgstr "วิธีเล่น · %d / %d"

#: scenes/greybox/tutorial.gd:178
msgid "Start playing"
msgstr "เริ่มเล่น"

#: scenes/greybox/tutorial.gd:178
msgid "Next ›"
msgstr "ถัดไป ›"

#. A small line over the board while the game keeps looking for an online opponent in the background.
#. Quick match is searching for an online opponent.
#: scenes/play/match_ui.gd:92 scenes/play/play_menu.gd:625
msgid "Looking for an opponent…"
msgstr "กำลังหาคู่แข่ง…"

#. Button: stop looking for an online opponent.
#: scenes/play/match_ui.gd:95
msgid "Stop looking"
msgstr "หยุดหา"

#. Button on "Opponent ready — play now?": leave the AI game (it's saved) and start the online game.
#: scenes/play/match_ui.gd:126
msgid "Play now"
msgstr "เล่นเลย"

#. Button on "Opponent ready — play now?": keep playing the AI and stop looking.
#: scenes/play/match_ui.gd:133 scenes/play/play_menu.gd:822
msgid "Not now"
msgstr "ไว้ก่อน"

#. The connection to the other player dropped. %d is the seconds left before the game is given up.
#: scenes/play/match_ui.gd:229
#, c-format
msgid "Reconnecting… %d s"
msgstr "กำลังเชื่อมต่อใหม่… %d วินาที"

#. The other player's device can no longer be reached.
#: scenes/play/match_ui.gd:233
msgid "Disconnected"
msgstr "ขาดการเชื่อมต่อ"

#. A quick-match opponent was found while the player plays the AI. Short: it sits over the board with two buttons.
#: scenes/play/match_ui.gd:261
msgid "Opponent ready — play now?"
msgstr "คู่แข่งพร้อมแล้ว — เล่นเลยไหม"

#: scenes/play/match_ui.gd:271
msgid "Your opponent offers a draw."
msgstr "คู่แข่งขอเสมอ"

#: scenes/play/match_ui.gd:271 scenes/play/match_ui.gd:274
msgid "Accept"
msgstr "ยอมรับ"

#: scenes/play/match_ui.gd:271 scenes/play/match_ui.gd:274
msgid "Decline"
msgstr "ปฏิเสธ"

#: scenes/play/match_ui.gd:274
msgid "Your opponent wants a rematch."
msgstr "คู่แข่งอยากแข่งอีกครั้ง"

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:281
msgid "Resign this game?"
msgstr "ยอมแพ้เกมนี้ไหม"

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:281 scenes/play/play_menu.gd:733
msgid "Resign"
msgstr "ยอมแพ้"

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:281
msgid "Keep playing"
msgstr "เล่นต่อ"

#: scenes/play/play_controller.gd:281
msgid "We'll let you know when an opponent is ready."
msgstr "เราจะแจ้งให้ทราบเมื่อคู่แข่งพร้อม"

#: scenes/play/play_controller.gd:315
msgid "Draw offered. Waiting for an answer."
msgstr "ขอเสมอแล้ว กำลังรอคำตอบ"

#: scenes/play/play_controller.gd:326
msgid "Rematch offered. Waiting for an answer."
msgstr "ขอแข่งอีกครั้งแล้ว กำลังรอคำตอบ"

#: scenes/play/play_controller.gd:328 scenes/play/play_controller.gd:425 scenes/play/play_text.gd:81 tools/smoke_multiplayer.gd:300
msgid "Your opponent left the game."
msgstr "คู่แข่งออกจากเกมแล้ว"

#: scenes/play/play_controller.gd:422
msgid "Reconnected."
msgstr "เชื่อมต่อใหม่แล้ว"

#: scenes/play/play_controller.gd:432 tools/smoke_multiplayer.gd:145
msgid "Your opponent declined the draw."
msgstr "คู่แข่งปฏิเสธการเสมอ"

#: scenes/play/play_controller.gd:433
msgid "Your opponent declined the rematch."
msgstr "คู่แข่งปฏิเสธการแข่งอีกครั้ง"

#. Shown when a game with another player starts. %s is their name, e.g. "Scribe 4821".
#: scenes/play/play_controller.gd:450
#, c-format
msgid "Playing against %s"
msgstr "กำลังเล่นกับ %s"

#: scenes/play/play_controller.gd:460
msgid "The other player didn't connect. Still looking…"
msgstr "ผู้เล่นอีกฝ่ายไม่ได้เชื่อมต่อ กำลังหาต่อ…"

#. The turn clock in online quick match ran out. %d is 1 or 2; at 3 the game is lost.
#: scenes/play/play_controller.gd:509
#, c-format
msgid "Time ran out, so a move was played for you (%d of 3)."
msgstr "หมดเวลา จึงเดินแทนคุณหนึ่งตา (ครั้งที่ %d จาก 3)"

#: scenes/play/play_menu.gd:251
msgid "Back"
msgstr "กลับ"

#: scenes/play/play_menu.gd:306
msgid "Rules"
msgstr "กติกา"

#: scenes/play/play_menu.gd:326
msgid "Language"
msgstr "ภาษา"

#. Menu button: go back to the game that was set aside.
#: scenes/play/play_menu.gd:352 scenes/play/play_menu.gd:723
msgid "Continue"
msgstr "เล่นต่อ"

#: scenes/play/play_menu.gd:353 scenes/play/play_menu.gd:379
msgid "Play against the AI"
msgstr "เล่นกับ AI"

#. Menu button: two people share this device and take turns.
#: scenes/play/play_menu.gd:355 scenes/play/play_menu.gd:399
msgid "Pass and play"
msgstr "สองคนเครื่องเดียว"

#. Menu button: play with someone on the same Wi-Fi network (each on their own device).
#: scenes/play/play_menu.gd:357 scenes/play/play_menu.gd:408
msgid "Play local"
msgstr "เล่นผ่าน Wi-Fi"

#: scenes/play/play_menu.gd:359 scenes/play/play_menu.gd:511
msgid "Play online"
msgstr "เล่นออนไลน์"

#: scenes/play/play_menu.gd:360 tests/test_localization.gd:14
msgid "How to play"
msgstr "วิธีเล่น"

#. Main menu button: opens a short history of the game, with its sources.
#: scenes/play/play_menu.gd:363 scenes/play/play_menu.gd:668
msgid "Game origins"
msgstr "ที่มาของเกม"

#. Main menu button: close the game completely.
#: scenes/play/play_menu.gd:370
msgid "Quit game"
msgstr "ออกจากเกม"

#: scenes/play/play_menu.gd:383
msgid "Novice"
msgstr "มือใหม่"

#: scenes/play/play_menu.gd:383
msgid "Apprentice"
msgstr "ฝึกหัด"

#: scenes/play/play_menu.gd:383
msgid "Adept"
msgstr "ชำนาญ"

#: scenes/play/play_menu.gd:383
msgid "Master"
msgstr "เซียน"

#. Menu label: how strong the computer opponent is.
#. Shown instead of a player's name when it can't be read.
#: scenes/play/play_menu.gd:388 scenes/play/play_text.gd:15
msgid "Opponent"
msgstr "คู่แข่ง"

#: scenes/play/play_menu.gd:391 scenes/play/play_menu.gd:403 scenes/play/play_menu.gd:427
msgid "Start"
msgstr "เริ่ม"

#: scenes/play/play_menu.gd:400
msgid "Two players share this device and take turns."
msgstr "ผู้เล่นสองคนใช้เครื่องนี้ร่วมกันและผลัดกันเดิน"

#: scenes/play/play_menu.gd:409
msgid "Both devices need to be on the same Wi-Fi."
msgstr "อุปกรณ์ทั้งสองต้องเชื่อมต่อ Wi-Fi เดียวกัน"

#. Menu button: start a game that another device on the same Wi-Fi can join.
#: scenes/play/play_menu.gd:412 scenes/play/play_menu.gd:423
msgid "Host a game"
msgstr "สร้างเกม"

#. Menu button: join a game another device on the same Wi-Fi is hosting.
#: scenes/play/play_menu.gd:414 scenes/play/play_menu.gd:455
msgid "Join a game"
msgstr "เข้าร่วมเกม"

#: scenes/play/play_menu.gd:423 scenes/play/play_menu.gd:542
msgid "Create a code"
msgstr "สร้างรหัส"

#: scenes/play/play_menu.gd:441
msgid "Waiting for a player"
msgstr "กำลังรอผู้เล่น"

#: scenes/play/play_menu.gd:442
msgid "On the other device, choose Play local, then Join a game."
msgstr "บนอุปกรณ์อีกเครื่อง เลือก “เล่นผ่าน Wi-Fi” แล้วเลือก “เข้าร่วมเกม”"

#. Above a code like 7KQ-2M4P that the other player can type to join.
#: scenes/play/play_menu.gd:446
msgid "If the game doesn't appear there, enter this code"
msgstr "ถ้าเกมไม่ปรากฏที่นั่น ให้ใส่รหัสนี้"

#: scenes/play/play_menu.gd:451 scenes/play/play_menu.gd:571 scenes/play/play_menu.gd:622 scenes/play/play_menu.gd:629 scenes/play/play_menu.gd:634
msgid "Cancel"
msgstr "ยกเลิก"

#. Shown while listening for games hosted on the same Wi-Fi; a list of games appears below.
#: scenes/play/play_menu.gd:457
msgid "Looking for games on this Wi-Fi…"
msgstr "กำลังหาเกมใน Wi-Fi นี้…"

#. Placeholder in the box for typing a nearby game's code.
#: scenes/play/play_menu.gd:468
msgid "Code"
msgstr "รหัส"

#: scenes/play/play_menu.gd:476 scenes/play/play_menu.gd:603
msgid "Join"
msgstr "เข้าร่วม"

#. Menu button: quick match against a random online player.
#: scenes/play/play_menu.gd:513
msgid "Play with someone online"
msgstr "เล่นกับผู้เล่นออนไลน์"

#. Small print under "Play with someone online".
#: scenes/play/play_menu.gd:518 scenes/play/play_menu.gd:627
msgid "Standard rules, about a minute per move"
msgstr "กติกามาตรฐาน ตาละประมาณหนึ่งนาที"

#: scenes/play/play_menu.gd:519 scenes/play/play_menu.gd:539
msgid "Play with a friend"
msgstr "เล่นกับเพื่อน"

#: scenes/play/play_menu.gd:540
msgid "One of you creates a code, the other enters it. It works between phones, tablets and computers."
msgstr "คนหนึ่งสร้างรหัส อีกคนใส่รหัสนั้น เล่นข้ามกันได้ทั้งโทรศัพท์ แท็บเล็ต และคอมพิวเตอร์"

#: scenes/play/play_menu.gd:543 scenes/play/play_menu.gd:587
msgid "Enter a code"
msgstr "ใส่รหัส"

#: scenes/play/play_menu.gd:551
msgid "Your code"
msgstr "รหัสของคุณ"

#: scenes/play/play_menu.gd:553 scenes/play/play_menu.gd:633
msgid "Connecting…"
msgstr "กำลังเชื่อมต่อ…"

#: scenes/play/play_menu.gd:556
msgid "Send this code to your friend. The game starts when they enter it."
msgstr "ส่งรหัสนี้ให้เพื่อน เกมจะเริ่มเมื่อเพื่อนใส่รหัส"

#: scenes/play/play_menu.gd:559
msgid "Share"
msgstr "แชร์"

#: scenes/play/play_menu.gd:561
msgid "Copy"
msgstr "คัดลอก"

#. Toast after copying the game code.
#: scenes/play/play_menu.gd:564 scenes/play/play_menu.gd:583
msgid "Copied"
msgstr "คัดลอกแล้ว"

#. Message sent with the system share sheet. %s is a code like TG-7KQ2.
#: scenes/play/play_menu.gd:577
#, c-format
msgid "Play with me in Timeless Games! My game code is %s."
msgstr "มาเล่นกับฉันใน Timeless Games! รหัสเกมของฉันคือ %s"

#. Quick match found no one after about a minute.
#: scenes/play/play_menu.gd:613
msgid "No one is free right now"
msgstr "ตอนนี้ยังไม่มีใครว่าง"

#: scenes/play/play_menu.gd:614
msgid "We can keep looking while you play."
msgstr "เราหาต่อให้ได้ระหว่างที่คุณเล่น"

#: scenes/play/play_menu.gd:615
msgid "Play against the AI while we keep looking"
msgstr "เล่นกับ AI ระหว่างที่เราหาต่อ"

#: scenes/play/play_menu.gd:618
msgid "Keep searching"
msgstr "หาต่อ"

#: scenes/play/play_menu.gd:619
msgid "Invite a friend instead"
msgstr "ชวนเพื่อนแทน"

#. Title over a message saying why a game with another player couldn't start.
#: scenes/play/play_menu.gd:639
msgid "Couldn't start the game"
msgstr "เริ่มเกมไม่ได้"

#: scenes/play/play_menu.gd:642
msgid "OK"
msgstr "ตกลง"

#. Asked before leaving a game against another player that's still going.
#: scenes/play/play_menu.gd:650
msgid "Leave this game?"
msgstr "ออกจากเกมนี้ไหม"

#: scenes/play/play_menu.gd:651
msgid "It counts as a loss."
msgstr "จะนับว่าคุณแพ้"

#: scenes/play/play_menu.gd:652
msgid "Leave"
msgstr "ออก"

#. Button: don't leave the game against another player.
#: scenes/play/play_menu.gd:658
msgid "Stay"
msgstr "อยู่ต่อ"

#. Heading over the list of books and articles at the end of "Game origins".
#: scenes/play/play_menu.gd:683
msgid "Sources"
msgstr "แหล่งอ้างอิง"

#: scenes/play/play_menu.gd:729
msgid "Offer a draw"
msgstr "ขอเสมอ"

#. Menu label: the visual style of board and pieces (a noun, not "to look"). Keep it short.
#: scenes/play/play_menu.gd:758
msgid "Look"
msgstr "รูปแบบ"

#. Settings label next to an on/off switch and a volume slider: the game's sound effects (pieces, end of game). Keep it short.
#: scenes/play/play_menu.gd:761
msgid "Sound"
msgstr "เสียง"

#. Settings label next to an on/off switch and a volume slider: the game's music. Keep it short.
#: scenes/play/play_menu.gd:763
msgid "Music"
msgstr "เพลง"

#. In-game menu button: shows Google's consent form again, to change the choice about ads and personal data.
#: scenes/play/play_menu.gd:767
msgid "Privacy choices"
msgstr "ตัวเลือกความเป็นส่วนตัว"

#. In-game menu button: end this game and go back to the main menu.
#: scenes/play/play_menu.gd:788
msgid "Quit to main menu"
msgstr "กลับเมนูหลัก"

#. Title of the screen offering the other looks (styles of board and pieces) for a short video.
#: scenes/play/play_menu.gd:802
msgid "More looks"
msgstr "รูปแบบอื่น"

#. On the "More looks" screen. The video is an ad; "until you close the game" means until the app is closed.
#: scenes/play/play_menu.gd:804
msgid "Watch a short video to switch looks until you close the game."
msgstr "ดูวิดีโอสั้น ๆ เพื่อเปลี่ยนรูปแบบได้จนกว่าจะปิดแอป"

#. On the "More looks" screen when no video could be loaded (offline, or none available).
#: scenes/play/play_menu.gd:808
msgid "No video is ready right now. Try again in a moment."
msgstr "ตอนนี้ยังไม่มีวิดีโอ ลองใหม่อีกครั้งในอีกสักครู่"

#. Button: play a short video (an ad) to open the other looks.
#: scenes/play/play_menu.gd:811
msgid "Watch a video"
msgstr "ดูวิดีโอ"

#. Settings label next to a list: the graphics quality (Auto, High, Medium, Low). Keep it short.
#: scenes/play/play_menu.gd:842
msgid "Graphics"
msgstr "กราฟิก"

#. Followed by this player's name as others see it, e.g. "Your name: Potter 4821".
#: scenes/play/play_menu.gd:923
#, c-format
msgid "Your name: %s"
msgstr "ชื่อของคุณ: %s"

#. Shown, with animated dots, while waiting for the other player to join.
#: scenes/play/play_menu.gd:960
msgid "Waiting"
msgstr "กำลังรอ"

#: scenes/play/play_text.gd:24
msgid "Scribe"
msgstr "อาลักษณ์"

#: scenes/play/play_text.gd:26
msgid "Traveller"
msgstr "นักเดินทาง"

#: scenes/play/play_text.gd:28
msgid "Potter"
msgstr "ช่างปั้น"

#: scenes/play/play_text.gd:30 tools/smoke_multiplayer.gd:284
msgid "Weaver"
msgstr "ช่างทอ"

#: scenes/play/play_text.gd:32
msgid "Shepherd"
msgstr "คนเลี้ยงแกะ"

#: scenes/play/play_text.gd:34
msgid "Boatman"
msgstr "คนพายเรือ"

#: scenes/play/play_text.gd:36
msgid "Gardener"
msgstr "คนสวน"

#: scenes/play/play_text.gd:38
msgid "Builder"
msgstr "ช่างก่อสร้าง"

#: scenes/play/play_text.gd:46
msgid "Can't reach the online service. Check your connection and try again."
msgstr "ติดต่อบริการออนไลน์ไม่ได้ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"

#: scenes/play/play_text.gd:48
msgid "No game has that code. Check it and try again."
msgstr "ไม่มีเกมที่ใช้รหัสนี้ ตรวจสอบแล้วลองอีกครั้ง"

#: scenes/play/play_text.gd:50
msgid "That game has already started."
msgstr "เกมนั้นเริ่มไปแล้ว"

#: scenes/play/play_text.gd:52
msgid "Couldn't connect to the other device."
msgstr "เชื่อมต่อกับอุปกรณ์อีกเครื่องไม่ได้"

#: scenes/play/play_text.gd:54
msgid "The other device has a different version of the game. Update both and try again."
msgstr "อุปกรณ์อีกเครื่องใช้เกมคนละเวอร์ชัน อัปเดตทั้งสองเครื่องแล้วลองอีกครั้ง"

#: scenes/play/play_text.gd:56
msgid "The other device is playing a different game."
msgstr "อุปกรณ์อีกเครื่องกำลังเล่นเกมอื่นอยู่"

#: scenes/play/play_text.gd:58
msgid "The other device uses rules this version doesn't have."
msgstr "อุปกรณ์อีกเครื่องใช้กติกาที่เวอร์ชันนี้ไม่มี"

#: scenes/play/play_text.gd:60
msgid "Couldn't start a game on this network. Close any other copy of the game and try again."
msgstr "เริ่มเกมบนเครือข่ายนี้ไม่ได้ ปิดเกมนี้ที่เปิดซ้อนอยู่แล้วลองอีกครั้ง"

#: scenes/play/play_text.gd:62
msgid "Local play needs permission to find devices on your network."
