msgstr[0] "%d capra catturata."
msgstr[1] "%d capre catturate."

#: titles/common/hunt_text.gd:120
#, c-format
msgid "%d dog captured."
msgid_plural "%d dogs captured."
msgstr[0] "%d cane catturato."
msgstr[1] "%d cani catturati."

#: titles/common/hunt_text.gd:124
