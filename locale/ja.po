msgid ""
msgstr ""
"Project-Id-Version: Timeless Games: hunt-games\n"
"Language: ja\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"
"X-Translator: Claude (2026-11-03)\n"
"X-Review-Status: translation confidence good; NEEDS native-speaker review before release (bible §7)\n"

#. Shown while the board and pieces of another look are prepared (it can take a few seconds).
#: scenes/greybox/greybox.gd:987
msgid "Loading…"
msgstr "読み込み中…"

#: scenes/greybox/hud.gd:146
msgid "Menu"
msgstr "メニュー"

#: scenes/greybox/hud.gd:170
msgid "Undo"
msgstr "一手戻す"

#. Button: end a chain of captures after the current jump.
#: scenes/greybox/hud.gd:269
msgid "Stop here"
msgstr "ここで止める"

#. Title of the list of moves played so far.
#: scenes/greybox/hud.gd:288
msgid "Moves"
msgstr "棋譜"

#. Button after a game against another player: play them again (sides swap).
#: scenes/greybox/hud.gd:339 scenes/greybox/hud.gd:543
msgid "Play again"
msgstr "もう一度"

#. Button after an online quick match: look for someone else to play.
#: scenes/greybox/hud.gd:349
msgid "New opponent"
msgstr "別の相手"

#. Button on the game-over card: back to the main menu.
#: scenes/greybox/hud.gd:354
msgid "Main menu"
msgstr "メインメニュー"

#. Button on the game-over card: close it to look at the final position.
#: scenes/greybox/hud.gd:358
msgid "Look at the board"
msgstr "盤面を見る"

#. The AI is choosing its move. Shown after the turn banner, followed by animated dots.
#: scenes/greybox/hud.gd:440
msgid "thinking"
msgstr "考え中"

#: scenes/greybox/hud.gd:482 scenes/greybox/hud.gd:531
msgid "A draw"
msgstr "引き分け"

#. Pieces captured so far / captures needed to win.
#: scenes/greybox/hud.gd:489
#, c-format
msgid "Captured %d / %d"
msgstr "取った数 %d / %d"

#: scenes/greybox/hud.gd:517
msgid "No moves yet"
msgstr "まだ手がありません"

#. Small line above the result when one player is on this device.
#: scenes/greybox/hud.gd:537 tools/smoke_multiplayer.gd:329
msgid "You won"
msgstr "あなたの勝ち"

#. Small line above the result when one player is on this device.
#: scenes/greybox/hud.gd:537 tools/smoke_multiplayer.gd:182
msgid "You lost"
msgstr "あなたの負け"

#. Button after a game against another player: play them again (sides swap).
#: scenes/greybox/hud.gd:543 tools/smoke_multiplayer.gd:184
msgid "Rematch"
msgstr "再戦"

#. Move list entry for putting a goat on the board. %s is a point name such as c3.
#: scenes/greybox/hud.gd:555
#, c-format
msgid "place %s"
msgstr "%s に置く"

#: scenes/greybox/hud.gd:564
msgid "Watching the AI play both sides."
msgstr "AI が両方を指しています。"

#: scenes/greybox/hud.gd:568
msgid "Waiting for your opponent's move."
msgstr "相手の手番を待っています。"

#: scenes/greybox/hud.gd:570
msgid "Capture chain: pick the next landing, or stop here."
msgstr "連続取り：次の着地点を選ぶか、ここで止めてください。"

#: scenes/greybox/hud.gd:576
msgid "Pick where it goes. A broken ring marks a capture."
msgstr "行き先を選んでください。切れた輪は取りを表します。"

#: scenes/greybox/hud.gd:577
msgid "Pick where it goes."
msgstr "行き先を選んでください。"

#: scenes/greybox/tutorial.gd:80
msgid "Close"
msgstr "閉じる"

#. Button: play this step of the walkthrough again.
#: scenes/greybox/tutorial.gd:84
msgid "Replay"
msgstr "もう一度見る"

#: scenes/greybox/tutorial.gd:87
msgid "‹ Back"
msgstr "‹ 戻る"

#. Step counter in the walkthrough: step number and number of steps.
#: scenes/greybox/tutorial.gd:182
#, c-format
msgid "How to play · %d of %d"
msgstr "遊び方 · %d / %d"

#: scenes/greybox/tutorial.gd:185
msgid "Start playing"
msgstr "対局を始める"

#: scenes/greybox/tutorial.gd:185
msgid "Next ›"
msgstr "次へ ›"

#. A small line over the board while the game keeps looking for an online opponent in the background.
#. Quick match is searching for an online opponent.
#: scenes/play/match_ui.gd:92 scenes/play/play_menu.gd:816
msgid "Looking for an opponent…"
msgstr "対戦相手を探しています…"

#. Button: stop looking for an online opponent.
#: scenes/play/match_ui.gd:95
msgid "Stop looking"
msgstr "探すのをやめる"

#. Button on "Opponent ready — play now?": leave the AI game (it's saved) and start the online game.
#: scenes/play/match_ui.gd:126
msgid "Play now"
msgstr "今すぐ対戦"

#. Button on "Opponent ready — play now?": keep playing the AI and stop looking.
#: scenes/play/match_ui.gd:133 scenes/play/play_menu.gd:1362
msgid "Not now"
msgstr "今はしない"

#. The connection to the other player dropped. %d is the seconds left before the game is given up.
#: scenes/play/match_ui.gd:229
#, c-format
msgid "Reconnecting… %d s"
msgstr "再接続中… %d 秒"

#. The other player's device can no longer be reached.
#: scenes/play/match_ui.gd:233
msgid "Disconnected"
msgstr "切断されました"

#. A quick-match opponent was found while the player plays the AI. Short: it sits over the board with two buttons.
#: scenes/play/match_ui.gd:261
msgid "Opponent ready — play now?"
msgstr "対戦相手が見つかりました。今すぐ対戦しますか？"

#: scenes/play/match_ui.gd:271
msgid "Your opponent offers a draw."
msgstr "相手が引き分けを提案しています。"

#: scenes/play/match_ui.gd:271 scenes/play/match_ui.gd:274
msgid "Accept"
msgstr "受ける"

#: scenes/play/match_ui.gd:271 scenes/play/match_ui.gd:274
msgid "Decline"
msgstr "断る"

#: scenes/play/match_ui.gd:274
msgid "Your opponent wants a rematch."
msgstr "相手が再戦を希望しています。"

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:281
msgid "Resign this game?"
msgstr "この対局を投了しますか？"

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:281 scenes/play/play_menu.gd:1072
msgid "Resign"
msgstr "投了する"

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:281
msgid "Keep playing"
msgstr "続ける"

#: scenes/play/play_controller.gd:281
msgid "We'll let you know when an opponent is ready."
msgstr "対戦相手が見つかったらお知らせします。"

#: scenes/play/play_controller.gd:315
msgid "Draw offered. Waiting for an answer."
msgstr "引き分けを提案しました。返事を待っています。"

#: scenes/play/play_controller.gd:326
msgid "Rematch offered. Waiting for an answer."
msgstr "再戦を申し込みました。返事を待っています。"

#: scenes/play/play_controller.gd:328 scenes/play/play_controller.gd:425 scenes/play/play_text.gd:81 tools/smoke_multiplayer.gd:328
msgid "Your opponent left the game."
msgstr "相手が対局を抜けました。"

#: scenes/play/play_controller.gd:422
msgid "Reconnected."
msgstr "再接続しました。"

#: scenes/play/play_controller.gd:432 tools/smoke_multiplayer.gd:173
msgid "Your opponent declined the draw."
msgstr "相手は引き分けを断りました。"

#: scenes/play/play_controller.gd:433
msgid "Your opponent declined the rematch."
msgstr "相手は再戦を断りました。"

#. Shown when a game with another player starts. %s is their name, e.g. "Scribe 4821".
#: scenes/play/play_controller.gd:450
#, c-format
msgid "Playing against %s"
msgstr "対戦相手：%s"

#: scenes/play/play_controller.gd:460
msgid "The other player didn't connect. Still looking…"
msgstr "相手が接続しませんでした。引き続き探しています…"

#. The turn clock in online quick match ran out. %d is 1 or 2; at 3 the game is lost.
#: scenes/play/play_controller.gd:509
#, c-format
msgid "Time ran out, so a move was played for you (%d of 3)."
msgstr "時間切れのため、代わりに一手指しました（%d／3 回）。"

#: scenes/play/play_menu.gd:316 tools/smoke_greybox.gd:294 tools/smoke_greybox.gd:388
msgid "Back"
msgstr "戻る"

#: scenes/play/play_menu.gd:376
msgid "Rules"
msgstr "ルール"

#: scenes/play/play_menu.gd:396
msgid "Language"
msgstr "言語"

#. Menu button: go back to the game that was set aside.
#: scenes/play/play_menu.gd:425 scenes/play/play_menu.gd:1062
msgid "Continue"
msgstr "続ける"

#: scenes/play/play_menu.gd:426 scenes/play/play_menu.gd:462
msgid "Play against the AI"
msgstr "AI と対局"

#. Menu button: two people share this device and take turns.
#: scenes/play/play_menu.gd:428 scenes/play/play_menu.gd:585
msgid "Pass and play"
msgstr "1台で2人対戦"

#. Menu button: play with someone on the same Wi-Fi network (each on their own device).
#: scenes/play/play_menu.gd:430 scenes/play/play_menu.gd:594
msgid "Play local"
msgstr "ローカル対戦"

#: scenes/play/play_menu.gd:432 scenes/play/play_menu.gd:697 scenes/play/play_menu.gd:774
msgid "Play online"
msgstr "オンライン対局"

#: scenes/play/play_menu.gd:433 tests/test_localization.gd:14
msgid "How to play"
msgstr "遊び方"

#. Main menu button: opens a short history of the game, with its sources.
#: scenes/play/play_menu.gd:436 scenes/play/play_menu.gd:859 tools/smoke_greybox.gd:330
msgid "Game origins"
msgstr "ゲームの由来"

#. Main menu button and the title of its screen: the other games in the series (this one is listed too), with links to their store pages. "Timeless Games" is the series' name: keep it in Latin letters, as written.
#: scenes/play/play_menu.gd:438 scenes/play/play_menu.gd:899 tools/smoke_greybox.gd:329 tools/smoke_greybox.gd:334
msgid "Other Timeless Games"
msgstr "その他のTimeless Games"

#. Main menu button and the title of its screen: look, graphics, sound, music, language and purchases, set before a game. Keep it short.
#: scenes/play/play_menu.gd:444 scenes/play/play_menu.gd:1121 tools/smoke_greybox.gd:244
msgid "Settings"
msgstr "設定"

#. Main menu button: close the game completely.
#: scenes/play/play_menu.gd:453
msgid "Quit game"
msgstr "ゲームを終了"

#. Menu label: how strong the computer opponent is.
#. Shown instead of a player's name when it can't be read.
#: scenes/play/play_menu.gd:475 scenes/play/play_menu.gd:491 scenes/play/play_text.gd:15
msgid "Opponent"
msgstr "対戦相手"

#: scenes/play/play_menu.gd:478 scenes/play/play_menu.gd:589 scenes/play/play_menu.gd:613
msgid "Start"
msgstr "開始"

#: scenes/play/play_menu.gd:586
msgid "Two players share this device and take turns."
msgstr "2人でこの端末を使い、交互に指します。"

#: scenes/play/play_menu.gd:595
msgid "Both devices need to be on the same Wi-Fi."
msgstr "2台の端末を同じ Wi-Fi に接続してください。"

#. Menu button: start a game that another device on the same Wi-Fi can join.
#: scenes/play/play_menu.gd:598 scenes/play/play_menu.gd:609
msgid "Host a game"
msgstr "対局を作る"

#. Menu button: join a game another device on the same Wi-Fi is hosting.
#: scenes/play/play_menu.gd:600 scenes/play/play_menu.gd:641
msgid "Join a game"
msgstr "対局に参加"

#: scenes/play/play_menu.gd:609 scenes/play/play_menu.gd:728
msgid "Create a code"
msgstr "コードを作る"

#: scenes/play/play_menu.gd:627
msgid "Waiting for a player"
msgstr "相手を待っています"

#: scenes/play/play_menu.gd:628
msgid "On the other device, choose Play local, then Join a game."
msgstr "もう1台で「ローカル対戦」、続いて「対局に参加」を選んでください。"

#. Above a code like 7KQ-2M4P that the other player can type to join.
#: scenes/play/play_menu.gd:632
msgid "If the game doesn't appear there, enter this code"
msgstr "表示されない場合は、このコードを入力してください"

#: scenes/play/play_menu.gd:637 scenes/play/play_menu.gd:757 scenes/play/play_menu.gd:813 scenes/play/play_menu.gd:820 scenes/play/play_menu.gd:825
msgid "Cancel"
msgstr "キャンセル"

#. Shown while listening for games hosted on the same Wi-Fi; a list of games appears below.
#: scenes/play/play_menu.gd:643
msgid "Looking for games on this Wi-Fi…"
msgstr "この Wi-Fi で対局を探しています…"

#. Placeholder in the box for typing a nearby game's code.
#: scenes/play/play_menu.gd:654
msgid "Code"
msgstr "コード"

#: scenes/play/play_menu.gd:662 scenes/play/play_menu.gd:794
msgid "Join"
msgstr "参加"

#. Menu button: quick match against a random online player.
#: scenes/play/play_menu.gd:699
msgid "Play with someone online"
msgstr "オンラインの誰かと対局"

#. Small print under "Play with someone online".
#: scenes/play/play_menu.gd:704 scenes/play/play_menu.gd:818
msgid "Standard rules, about a minute per move"
msgstr "標準ルール・1手あたり約1分"

#: scenes/play/play_menu.gd:705 scenes/play/play_menu.gd:725 scenes/play/play_menu.gd:774
msgid "Play with a friend"
msgstr "友だちと対局"

#: scenes/play/play_menu.gd:726
msgid "One of you creates a code, the other enters it. It works between phones, tablets and computers."
msgstr "1人がコードを作り、もう1人が入力します。スマホ、タブレット、パソコンの間で遊べます。"

#: scenes/play/play_menu.gd:729 scenes/play/play_menu.gd:774 scenes/play/play_menu.gd:778
msgid "Enter a code"
msgstr "コードを入力"

#: scenes/play/play_menu.gd:737
msgid "Your code"
msgstr "あなたのコード"

#: scenes/play/play_menu.gd:739 scenes/play/play_menu.gd:824
msgid "Connecting…"
msgstr "接続中…"

#: scenes/play/play_menu.gd:742
msgid "Send this code to your friend. The game starts when they enter it."
msgstr "このコードを友だちに送ってください。入力されると対局が始まります。"

#: scenes/play/play_menu.gd:745 scenes/play/play_menu.gd:765
msgid "Share"
msgstr "共有"

#: scenes/play/play_menu.gd:747
msgid "Copy"
msgstr "コピー"

#. Toast after copying the game code.
#: scenes/play/play_menu.gd:750 scenes/play/play_menu.gd:768
msgid "Copied"
msgstr "コピーしました"

#. Message sent with the system share sheet. The first %s is the game's name (Bagh Chal), the second a code like TG-7K4Q. A line with the menu path to enter the code follows it.
#: scenes/play/play_menu.gd:773
#, c-format
msgid "Play %s with me! My game code is %s."
msgstr "%s で一緒に遊ぼう！対局コードは %s です。"

#. Quick match found no one after about a minute.
#: scenes/play/play_menu.gd:804
msgid "No one is free right now"
msgstr "今は誰も空いていません"

#: scenes/play/play_menu.gd:805
msgid "We can keep looking while you play."
msgstr "対局しているあいだも探し続けられます。"

#: scenes/play/play_menu.gd:806
msgid "Play against the AI while we keep looking"
msgstr "探しているあいだ AI と対局"

#: scenes/play/play_menu.gd:809
msgid "Keep searching"
msgstr "探し続ける"

#: scenes/play/play_menu.gd:810
msgid "Invite a friend instead"
msgstr "代わりに友だちを誘う"

#. Title over a message saying why a game with another player couldn't start.
#: scenes/play/play_menu.gd:830
msgid "Couldn't start the game"
msgstr "対局を始められませんでした"

#: scenes/play/play_menu.gd:833
msgid "OK"
msgstr "OK"

#. Asked before leaving a game against another player that's still going.
#: scenes/play/play_menu.gd:841
msgid "Leave this game?"
msgstr "この対局を抜けますか？"

#: scenes/play/play_menu.gd:842
msgid "It counts as a loss."
msgstr "負けになります。"

#: scenes/play/play_menu.gd:843
msgid "Leave"
msgstr "抜ける"

#. Button: don't leave the game against another player.
#: scenes/play/play_menu.gd:849
msgid "Stay"
msgstr "残る"

#. Heading over the list of books and articles at the end of "Game origins".
#: scenes/play/play_menu.gd:874
msgid "Sources"
msgstr "参考文献"

#. Tab on the "Other Timeless Games" screen: games already in the store.
#: scenes/play/play_menu.gd:908 tools/smoke_greybox.gd:335
msgid "Available now"
msgstr "配信中"

#. Tab on the "Other Timeless Games" screen: games not out yet.
#: scenes/play/play_menu.gd:910 tools/smoke_greybox.gd:336
msgid "Coming soon"
msgstr "近日配信"

#. On the "Other Timeless Games" screen, when a tab has no games in it.
#: scenes/play/play_menu.gd:933 tools/smoke_greybox.gd:359
msgid "No games here yet."
msgstr "ここにはまだゲームがありません。"

#: scenes/play/play_menu.gd:1068
msgid "Offer a draw"
msgstr "引き分けを提案"

#. In-game menu button: end this game and go back to the main menu.
#: scenes/play/play_menu.gd:1108
msgid "Quit to main menu"
msgstr "メインメニューに戻る"

#. Menu label: the visual style of board and pieces (a noun, not "to look"). Keep it short.
#: scenes/play/play_menu.gd:1150
msgid "Look"
msgstr "見た目"

#. Settings label next to an on/off switch and a volume slider: the game's sound effects (pieces, end of game). Keep it short.
#: scenes/play/play_menu.gd:1153
msgid "Sound"
msgstr "効果音"

#. Settings label next to an on/off switch and a volume slider: the game's music. Keep it short.
#: scenes/play/play_menu.gd:1155
msgid "Music"
msgstr "音楽"

#. Settings switch: makes every text in the game bigger. Keep it short.
#: scenes/play/play_menu.gd:1178 tools/smoke_greybox.gd:258 tools/smoke_greybox.gd:307
msgid "Large text"
msgstr "大きな文字"

#. Settings switch: the phone vibrates lightly when a piece moves, at a capture and at the end of a game. The phone's usual word. Keep it short.
#: scenes/play/play_menu.gd:1182 tools/smoke_greybox.gd:259
msgid "Vibration"
msgstr "バイブレーション"

#. Settings button: opens Game Center (iPhone/iPad) or Google Play Games (Android) on the game's achievements. The usual platform word.
#: scenes/play/play_menu.gd:1222
msgid "Achievements"
msgstr "実績"

#. Message when Game Center or Google Play Games can't open (not signed in, offline).
#: scenes/play/play_menu.gd:1226
msgid "Achievements aren't available right now."
msgstr "現在、実績を表示できません。"

#. Settings button and screen title: who made the game, and the open-source licences.
#: scenes/play/play_menu.gd:1228 scenes/play/play_menu.gd:1239 tools/smoke_greybox.gd:271
msgid "Credits"
msgstr "クレジット"

#. On the Credits screen. First %s: the game's name (e.g. "Bagh Chal"); second %s: the name of the person who made it.
#: scenes/play/play_menu.gd:1242
#, c-format
msgid "%s is a game by %s."
msgstr "%sは%sによるゲームです。"

#. Button and screen title: the licences of the open-source software and fonts the game uses.
#: scenes/play/play_menu.gd:1245 scenes/play/play_menu.gd:1252 scenes/play/play_menu.gd:1292 tools/smoke_greybox.gd:278
msgid "Open-source licenses"
msgstr "オープンソースライセンス"

#. On the "Open-source licenses" screen, above the list. "Tap" also covers clicking.
#: scenes/play/play_menu.gd:1254
msgid "This game is made with the software and fonts below. Tap one to read its license."
msgstr "このゲームは以下のソフトウェアとフォントを使用しています。項目をタップするとライセンスを表示します。"

#. Title of the screen offering the other looks (styles of board and pieces) for a short video.
#: scenes/play/play_menu.gd:1334
msgid "More looks"
msgstr "ほかの見た目"

#. On the "More looks" screen. The video is an ad; "until you close the game" means until the app is closed.
#: scenes/play/play_menu.gd:1336
msgid "Watch a short video to switch looks until you close the game."
msgstr "短い動画を見ると、ゲームを閉じるまで見た目を自由に切り替えられます。"

#. On the "More looks" screen when no video could be loaded (offline, or none available).
#: scenes/play/play_menu.gd:1340
msgid "No video is ready right now. Try again in a moment."
msgstr "いまは再生できる動画がありません。少し待ってからもう一度お試しください。"

#. Button: play a short video (an ad) to open the other looks.
#: scenes/play/play_menu.gd:1343
msgid "Watch a video"
msgstr "動画を見る"

#. On the "More looks" screen, above the Remove ads button: buying it opens every look permanently.
#: scenes/play/play_menu.gd:1359
msgid "Or remove ads to keep every look for good."
msgstr "または広告を削除すると、すべての見た目をずっと使えます。"

#. Button: buy "Remove ads" (no more ads, and every look of the board open for good). %s is the store's price, e.g. "US$1.99". Keep it short.
#: scenes/play/play_menu.gd:1360 scenes/play/play_menu.gd:1374 tools/smoke_greybox.gd:222 tools/smoke_greybox.gd:254
#, c-format
msgid "Remove ads · %s"
msgstr "広告を削除 · %s"

#. In-game menu button: get back a purchase made before with the same store account (a new phone, a reinstall). The usual store wording. Shares a row with "Privacy choices".
#: scenes/play/play_menu.gd:1380 tools/smoke_greybox.gd:231
msgid "Restore purchases"
msgstr "購入を復元"

#. In-game menu button: shows Google's consent form again, to change the choice about ads and personal data.
#: scenes/play/play_menu.gd:1384
msgid "Privacy choices"
msgstr "プライバシーの設定"

#. Message after buying "Remove ads": thanks, no more ads, and every look (style of board and pieces) is theirs.
#: scenes/play/play_menu.gd:1403
msgid "Thank you! Ads are off and every look is yours."
msgstr "ありがとうございます！広告がなくなり、すべての見た目を使えるようになりました。"

#. Message when the store holds the payment for "Remove ads" (e.g. paying in cash, or a parent must approve).
#: scenes/play/play_menu.gd:1413
msgid "Your payment is pending. Ads will turn off as soon as it goes through."
msgstr "お支払いは保留中です。支払いが完了すると広告は表示されなくなります。"

#. Message when buying "Remove ads" failed (not when the player cancelled).
#: scenes/play/play_menu.gd:1416
msgid "The purchase didn't go through. Please try again later."
msgstr "購入を完了できませんでした。しばらくしてからもう一度お試しください。"

#. Message after "Restore purchases" found Remove ads.
#: scenes/play/play_menu.gd:1426
msgid "Your purchase is restored."
msgstr "購入を復元しました。"

#. Message after "Restore purchases" found nothing bought with this store account.
#: scenes/play/play_menu.gd:1429
msgid "No purchase to restore on this account."
msgstr "このアカウントには復元できる購入がありません。"

#. Message when the store (Google Play, the App Store) can't be reached.
#: scenes/play/play_menu.gd:1432
msgid "The store isn't available right now."
msgstr "現在ストアを利用できません。"

#. Settings label next to a list: the graphics quality (Auto, High, Medium, Low). Keep it short.
#: scenes/play/play_menu.gd:1454
msgid "Graphics"
msgstr "画質"

#. Followed by this player's name as others see it, e.g. "Your name: Potter 4821".
#: scenes/play/play_menu.gd:1535
#, c-format
msgid "Your name: %s"
msgstr "あなたの名前：%s"

#. Shown, with animated dots, while waiting for the other player to join.
#: scenes/play/play_menu.gd:1572
msgid "Waiting"
msgstr "待機中"

#: scenes/play/play_text.gd:24
msgid "Scribe"
msgstr "書記"

#: scenes/play/play_text.gd:26
msgid "Traveller"
msgstr "旅人"

