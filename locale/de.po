msgstr "Anfänger"

#. The four AI strength levels, weakest to strongest. Later they become named opponents.
#: scenes/greybox/hud.gd:233
msgid "Apprentice"
msgstr "Lehrling"

#. The four AI strength levels, weakest to strongest. Later they become named opponents.
#: scenes/greybox/hud.gd:233
msgid "Adept"
msgstr "Könner"

#. The four AI strength levels, weakest to strongest. Later they become named opponents.
#: scenes/greybox/hud.gd:233
msgid "Master"
msgstr "Meister"

#. Menu label: the computer opponent's strength. Keep it short.
#: scenes/greybox/hud.gd:239
msgid "AI"
msgstr "KI"

#. Menu label: the visual style of board and pieces (a noun, not "to look"). Keep it short.
#: scenes/greybox/hud.gd:247
msgid "Look"
msgstr "Stil"

#: scenes/greybox/hud.gd:256
msgid "Language"
msgstr "Sprache"

#: scenes/greybox/hud.gd:262
msgid "New game"
msgstr "Neue Partie"

#: scenes/greybox/hud.gd:267
msgid "Undo"
msgstr "Rückgängig"

#: scenes/greybox/hud.gd:274
msgid "How to play"
msgstr "Spielanleitung"

#. Keyboard shortcuts. N, U, H and T are the keys and stay as they are.
#: scenes/greybox/hud.gd:278
msgid "N new game · U undo · H hide panels · T how to play"
msgstr "N neue Partie · U rückgängig · H Felder ausblenden · T Spielanleitung"

#. Button: end a chain of captures after the current jump.
#: scenes/greybox/hud.gd:304
msgid "Stop here"
msgstr "Hier aufhören"

#. Title of the list of moves played so far.
#: scenes/greybox/hud.gd:322
msgid "Moves"
msgstr "Züge"

#: scenes/greybox/hud.gd:371
msgid "Play again"
msgstr "Noch einmal"

#. Button on the game-over card: close it to look at the final position.
#: scenes/greybox/hud.gd:376
msgid "Look at the board"
msgstr "Brett ansehen"

#. The AI is choosing its move. Shown after the turn banner, followed by animated dots.
#: scenes/greybox/hud.gd:419
msgid "thinking"
msgstr "überlegt"

#. Two people taking turns on the same device.
#: scenes/greybox/hud.gd:435
msgid "Two players (hotseat)"
msgstr "Zwei Spieler (ein Gerät)"

#: scenes/greybox/hud.gd:438
msgid "Watch the AI play"
msgstr "Der KI zusehen"

#: scenes/greybox/hud.gd:468 scenes/greybox/hud.gd:518
msgid "A draw"
msgstr "Unentschieden"

#. Pieces captured so far / captures needed to win.
#: scenes/greybox/hud.gd:475
#, c-format
msgid "Captured %d / %d"
msgstr "Geschlagen %d / %d"

#. Count toward the draw rule: moves (by either side) since the last capture / the limit.
#: scenes/greybox/hud.gd:486
#, c-format
msgid "Moves without a capture: %d / %d"
msgstr "Züge ohne Schlagen: %d / %d"

#: scenes/greybox/hud.gd:504
msgid "No moves yet"
msgstr "Noch keine Züge"

#. Move list entry for putting a goat on the board. %s is a point name such as c3.
#: scenes/greybox/hud.gd:531
#, c-format
msgid "place %s"
msgstr "setzt auf %s"

#: scenes/greybox/hud.gd:540
msgid "Watching the AI play both sides."
msgstr "Die KI spielt beide Seiten."

#: scenes/greybox/hud.gd:544
msgid "Capture chain: pick the next landing, or stop here."
msgstr "Schlagkette: Wähle den nächsten Sprung oder hör hier auf."

#: scenes/greybox/hud.gd:550
msgid "Pick where it goes. A broken ring marks a capture."
msgstr "Wähle das Ziel. Ein unterbrochener Ring zeigt einen Schlag."

#: scenes/greybox/hud.gd:551
msgid "Pick where it goes."
msgstr "Wähle das Ziel."

#: scenes/greybox/tutorial.gd:76
msgid "Close"
msgstr "Schließen"

#. Button: play this step of the walkthrough again.
#: scenes/greybox/tutorial.gd:80
msgid "Replay"
msgstr "Wiederholen"

#: scenes/greybox/tutorial.gd:83
msgid "‹ Back"
msgstr "‹ Zurück"

#. Step counter in the walkthrough: step number and number of steps.
#: scenes/greybox/tutorial.gd:159
#, c-format
msgid "How to play · %d of %d"
msgstr "Spielanleitung · %d von %d"

#: scenes/greybox/tutorial.gd:162
msgid "Start playing"
msgstr "Losspielen"

#: scenes/greybox/tutorial.gd:162
msgid "Next ›"
msgstr "Weiter ›"

#: titles/bagh_chal/art/brass_style.gd:38
msgid "Temple brass"
msgstr "Tempelmessing"

#: titles/bagh_chal/art/brass_style.gd:39
msgid "An engraved brass board and cast figures, at dusk in a temple courtyard."
msgstr "Ein graviertes Messingbrett und gegossene Figuren, in der Abenddämmerung im Hof eines Tempels."

#: titles/bagh_chal/art/stone_style.gd:38
msgid "Stone and pebbles"
msgstr "Stein und Kiesel"

#: titles/bagh_chal/art/stone_style.gd:39
msgid "The historical way: lines cut into stone and chalked, tigers and goats of river stone, on a straw mat."
msgstr "Wie früher: Linien in Stein gehauen und mit Kreide nachgezogen, Tiger und Ziegen aus Flusssteinen, auf einer Strohmatte."

#. Subtitle under the game name: which rule set is being played.
#: titles/common/hunt_text.gd:26
msgid "Standard rules"
msgstr "Standardregeln"

#: titles/common/hunt_text.gd:28
msgid "Parlett 1976: hunt to the last goat"
msgstr "Parlett 1976: Jagd bis zur letzten Ziege"

#: titles/common/hunt_text.gd:30
msgid "Adugo, the Bororo rules"
msgstr "Adugo, die Regeln der Bororo"

#. Komikan is a game of the Mapuche people (Chile, Argentina); our rules are a reconstruction from old written accounts.
#: titles/common/hunt_text.gd:33
msgid "Komikan, a Mapuche reconstruction"
msgstr "Komikan, ein rekonstruiertes Spiel der Mapuche"

#: titles/common/hunt_text.gd:40
msgid "Bagh Chal · Standard"
msgstr "Bagh Chal · Standard"

#: titles/common/hunt_text.gd:42
msgid "Bagh Chal · Parlett 1976"
msgstr "Bagh Chal · Parlett 1976"

#: titles/common/hunt_text.gd:44
