msgid ""
msgstr ""
"Project-Id-Version: Timeless Games: hunt-games\n"
"Language: tr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Translator: Claude (2026-11-03)\n"
"X-Review-Status: translation confidence good; NEEDS native-speaker review before release (bible §7)\n"

#. Shown while the board and pieces of another look are prepared (it can take a few seconds).
#: scenes/greybox/greybox.gd:979
msgid "Loading…"
msgstr "Yükleniyor…"

#: scenes/greybox/hud.gd:146
msgid "Menu"
msgstr "Menü"

#: scenes/greybox/hud.gd:170
msgid "Undo"
msgstr "Geri al"

#. Button: end a chain of captures after the current jump.
#: scenes/greybox/hud.gd:269
msgid "Stop here"
msgstr "Burada dur"

#. Title of the list of moves played so far.
#: scenes/greybox/hud.gd:288
msgid "Moves"
msgstr "Hamleler"

#. Button after a game against another player: play them again (sides swap).
#: scenes/greybox/hud.gd:339 scenes/greybox/hud.gd:535
msgid "Play again"
msgstr "Tekrar oyna"

#. Button after an online quick match: look for someone else to play.
#: scenes/greybox/hud.gd:349
msgid "New opponent"
msgstr "Yeni rakip"

#. Button on the game-over card: back to the main menu.
#: scenes/greybox/hud.gd:354
msgid "Main menu"
msgstr "Ana menü"

#. Button on the game-over card: close it to look at the final position.
#: scenes/greybox/hud.gd:358
msgid "Look at the board"
msgstr "Tahtaya bak"

#. The AI is choosing its move. Shown after the turn banner, followed by animated dots.
#: scenes/greybox/hud.gd:433
msgid "thinking"
msgstr "düşünüyor"

#: scenes/greybox/hud.gd:474 scenes/greybox/hud.gd:523
msgid "A draw"
msgstr "Berabere"

#. Pieces captured so far / captures needed to win.
#: scenes/greybox/hud.gd:481
#, c-format
msgid "Captured %d / %d"
msgstr "Alınan: %d / %d"

#: scenes/greybox/hud.gd:509
msgid "No moves yet"
msgstr "Henüz hamle yok"

#. Small line above the result when one player is on this device.
#: scenes/greybox/hud.gd:529 tools/smoke_multiplayer.gd:326
msgid "You won"
msgstr "Kazandın"

#. Small line above the result when one player is on this device.
#: scenes/greybox/hud.gd:529 tools/smoke_multiplayer.gd:179
msgid "You lost"
msgstr "Kaybettin"

#. Button after a game against another player: play them again (sides swap).
#: scenes/greybox/hud.gd:535 tools/smoke_multiplayer.gd:181
msgid "Rematch"
msgstr "Rövanş"

#. Move list entry for putting a goat on the board. %s is a point name such as c3.
#: scenes/greybox/hud.gd:547
#, c-format
msgid "place %s"
msgstr "koy: %s"

#: scenes/greybox/hud.gd:556
msgid "Watching the AI play both sides."
msgstr "YZ iki tarafı da oynuyor."

#: scenes/greybox/hud.gd:560
msgid "Waiting for your opponent's move."
msgstr "Rakibin hamlesi bekleniyor."

#: scenes/greybox/hud.gd:562
msgid "Capture chain: pick the next landing, or stop here."
msgstr "Alış zinciri: sıradaki atlamayı seç ya da burada dur."

#: scenes/greybox/hud.gd:568
msgid "Pick where it goes. A broken ring marks a capture."
msgstr "Nereye gideceğini seç. Kırık halka bir alışı gösterir."

#: scenes/greybox/hud.gd:569
msgid "Pick where it goes."
msgstr "Nereye gideceğini seç."

#: scenes/greybox/tutorial.gd:79
msgid "Close"
msgstr "Kapat"

#. Button: play this step of the walkthrough again.
#: scenes/greybox/tutorial.gd:83
msgid "Replay"
msgstr "Tekrarla"

#: scenes/greybox/tutorial.gd:86
msgid "‹ Back"
msgstr "‹ Geri"

#. Step counter in the walkthrough: step number and number of steps.
#: scenes/greybox/tutorial.gd:179
#, c-format
msgid "How to play · %d of %d"
msgstr "Nasıl oynanır · %d / %d"

#: scenes/greybox/tutorial.gd:182
msgid "Start playing"
msgstr "Oynamaya başla"

#: scenes/greybox/tutorial.gd:182
msgid "Next ›"
msgstr "İleri ›"

#. A small line over the board while the game keeps looking for an online opponent in the background.
#. Quick match is searching for an online opponent.
#: scenes/play/match_ui.gd:92 scenes/play/play_menu.gd:784
msgid "Looking for an opponent…"
msgstr "Rakip aranıyor…"

#. Button: stop looking for an online opponent.
#: scenes/play/match_ui.gd:95
msgid "Stop looking"
msgstr "Aramayı durdur"

#. Button on "Opponent ready — play now?": leave the AI game (it's saved) and start the online game.
#: scenes/play/match_ui.gd:126
msgid "Play now"
msgstr "Şimdi oyna"

#. Button on "Opponent ready — play now?": keep playing the AI and stop looking.
#: scenes/play/match_ui.gd:133 scenes/play/play_menu.gd:1182
msgid "Not now"
msgstr "Şimdi değil"

#. The connection to the other player dropped. %d is the seconds left before the game is given up.
#: scenes/play/match_ui.gd:229
#, c-format
msgid "Reconnecting… %d s"
msgstr "Yeniden bağlanıyor… %d sn"

#. The other player's device can no longer be reached.
#: scenes/play/match_ui.gd:233
msgid "Disconnected"
msgstr "Bağlantı kesildi"

#. A quick-match opponent was found while the player plays the AI. Short: it sits over the board with two buttons.
#: scenes/play/match_ui.gd:261
msgid "Opponent ready — play now?"
msgstr "Rakip hazır, şimdi oynamak ister misin?"

#: scenes/play/match_ui.gd:271
msgid "Your opponent offers a draw."
msgstr "Rakibin beraberlik teklif ediyor."

#: scenes/play/match_ui.gd:271 scenes/play/match_ui.gd:274
msgid "Accept"
msgstr "Kabul et"

#: scenes/play/match_ui.gd:271 scenes/play/match_ui.gd:274
msgid "Decline"
msgstr "Reddet"

#: scenes/play/match_ui.gd:274
msgid "Your opponent wants a rematch."
msgstr "Rakibin rövanş istiyor."

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:281
msgid "Resign this game?"
msgstr "Bu oyunda pes edilsin mi?"

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:281 scenes/play/play_menu.gd:892
msgid "Resign"
msgstr "Pes et"

#. Confirmation before giving up a game against another player.
#: scenes/play/match_ui.gd:281
msgid "Keep playing"
msgstr "Oynamaya devam et"

#: scenes/play/play_controller.gd:281
msgid "We'll let you know when an opponent is ready."
msgstr "Bir rakip hazır olduğunda haber vereceğiz."

#: scenes/play/play_controller.gd:315
msgid "Draw offered. Waiting for an answer."
msgstr "Beraberlik teklif edildi. Yanıt bekleniyor."

#: scenes/play/play_controller.gd:326
msgid "Rematch offered. Waiting for an answer."
msgstr "Rövanş teklif edildi. Yanıt bekleniyor."

#: scenes/play/play_controller.gd:328 scenes/play/play_controller.gd:425 scenes/play/play_text.gd:81 tools/smoke_multiplayer.gd:325
msgid "Your opponent left the game."
msgstr "Rakibin oyundan ayrıldı."

#: scenes/play/play_controller.gd:422
msgid "Reconnected."
msgstr "Yeniden bağlandı."

#: scenes/play/play_controller.gd:432 tools/smoke_multiplayer.gd:170
msgid "Your opponent declined the draw."
msgstr "Rakibin beraberliği reddetti."

#: scenes/play/play_controller.gd:433
msgid "Your opponent declined the rematch."
msgstr "Rakibin rövanşı reddetti."

#. Shown when a game with another player starts. %s is their name, e.g. "Scribe 4821".
#: scenes/play/play_controller.gd:450
#, c-format
msgid "Playing against %s"
msgstr "Rakibin: %s"

#: scenes/play/play_controller.gd:460
msgid "The other player didn't connect. Still looking…"
msgstr "Diğer oyuncu bağlanmadı. Aramaya devam ediliyor…"

#. The turn clock in online quick match ran out. %d is 1 or 2; at 3 the game is lost.
#: scenes/play/play_controller.gd:509
#, c-format
msgid "Time ran out, so a move was played for you (%d of 3)."
msgstr "Süre doldu, senin yerine hamle yapıldı (%d/3)."

#: scenes/play/play_menu.gd:293 tools/smoke_greybox.gd:292
msgid "Back"
msgstr "Geri"

#: scenes/play/play_menu.gd:353
msgid "Rules"
msgstr "Kurallar"

#: scenes/play/play_menu.gd:373
msgid "Language"
msgstr "Dil"

#. Menu button: go back to the game that was set aside.
#: scenes/play/play_menu.gd:400 scenes/play/play_menu.gd:882
msgid "Continue"
msgstr "Devam et"

#: scenes/play/play_menu.gd:401 scenes/play/play_menu.gd:430
msgid "Play against the AI"
msgstr "YZ'ye karşı oyna"

#. Menu button: two people share this device and take turns.
#: scenes/play/play_menu.gd:403 scenes/play/play_menu.gd:553
msgid "Pass and play"
msgstr "Aynı cihazda iki kişi"

#. Menu button: play with someone on the same Wi-Fi network (each on their own device).
#: scenes/play/play_menu.gd:405 scenes/play/play_menu.gd:562
msgid "Play local"
msgstr "Yerel oyna"

#: scenes/play/play_menu.gd:407 scenes/play/play_menu.gd:665 scenes/play/play_menu.gd:742
msgid "Play online"
msgstr "Çevrimiçi oyna"

#: scenes/play/play_menu.gd:408 tests/test_localization.gd:14
msgid "How to play"
msgstr "Nasıl oynanır"

#. Main menu button: opens a short history of the game, with its sources.
#: scenes/play/play_menu.gd:411 scenes/play/play_menu.gd:827
msgid "Game origins"
msgstr "Oyunun kökeni"

#. Main menu button and the title of its screen: look, graphics, sound, music, language and purchases, set before a game. Keep it short.
#: scenes/play/play_menu.gd:413 scenes/play/play_menu.gd:941 tools/smoke_greybox.gd:242
msgid "Settings"
msgstr "Ayarlar"

#. Main menu button: close the game completely.
#: scenes/play/play_menu.gd:421
msgid "Quit game"
msgstr "Oyundan çık"

#. Menu label: how strong the computer opponent is.
#. Shown instead of a player's name when it can't be read.
#: scenes/play/play_menu.gd:443 scenes/play/play_menu.gd:459 scenes/play/play_text.gd:15
msgid "Opponent"
msgstr "Rakip"

#: scenes/play/play_menu.gd:446 scenes/play/play_menu.gd:557 scenes/play/play_menu.gd:581
msgid "Start"
msgstr "Başla"

#: scenes/play/play_menu.gd:554
msgid "Two players share this device and take turns."
msgstr "İki oyuncu bu cihazı paylaşır ve sırayla oynar."

#: scenes/play/play_menu.gd:563
msgid "Both devices need to be on the same Wi-Fi."
msgstr "İki cihaz da aynı Wi-Fi ağında olmalı."

#. Menu button: start a game that another device on the same Wi-Fi can join.
#: scenes/play/play_menu.gd:566 scenes/play/play_menu.gd:577
msgid "Host a game"
msgstr "Oyun kur"

#. Menu button: join a game another device on the same Wi-Fi is hosting.
#: scenes/play/play_menu.gd:568 scenes/play/play_menu.gd:609
msgid "Join a game"
msgstr "Oyuna katıl"

#: scenes/play/play_menu.gd:577 scenes/play/play_menu.gd:696
msgid "Create a code"
msgstr "Kod oluştur"

#: scenes/play/play_menu.gd:595
msgid "Waiting for a player"
msgstr "Oyuncu bekleniyor"

#: scenes/play/play_menu.gd:596
msgid "On the other device, choose Play local, then Join a game."
msgstr "Diğer cihazda Yerel oyna'yı, sonra Oyuna katıl'ı seç."

#. Above a code like 7KQ-2M4P that the other player can type to join.
#: scenes/play/play_menu.gd:600
msgid "If the game doesn't appear there, enter this code"
msgstr "Oyun orada görünmezse bu kodu gir"

#: scenes/play/play_menu.gd:605 scenes/play/play_menu.gd:725 scenes/play/play_menu.gd:781 scenes/play/play_menu.gd:788 scenes/play/play_menu.gd:793
msgid "Cancel"
msgstr "İptal"

#. Shown while listening for games hosted on the same Wi-Fi; a list of games appears below.
#: scenes/play/play_menu.gd:611
msgid "Looking for games on this Wi-Fi…"
msgstr "Bu Wi-Fi ağında oyun aranıyor…"

#. Placeholder in the box for typing a nearby game's code.
#: scenes/play/play_menu.gd:622
msgid "Code"
msgstr "Kod"

#: scenes/play/play_menu.gd:630 scenes/play/play_menu.gd:762
msgid "Join"
msgstr "Katıl"

#. Menu button: quick match against a random online player.
#: scenes/play/play_menu.gd:667
msgid "Play with someone online"
msgstr "Çevrimiçi biriyle oyna"

#. Small print under "Play with someone online".
#: scenes/play/play_menu.gd:672 scenes/play/play_menu.gd:786
msgid "Standard rules, about a minute per move"
msgstr "Standart kurallar, hamle başına yaklaşık bir dakika"

#: scenes/play/play_menu.gd:673 scenes/play/play_menu.gd:693 scenes/play/play_menu.gd:742
msgid "Play with a friend"
msgstr "Bir arkadaşla oyna"

#: scenes/play/play_menu.gd:694
msgid "One of you creates a code, the other enters it. It works between phones, tablets and computers."
msgstr "Biriniz kod oluşturur, diğeri girer. Telefon, tablet ve bilgisayarlar arasında çalışır."

#: scenes/play/play_menu.gd:697 scenes/play/play_menu.gd:742 scenes/play/play_menu.gd:746
msgid "Enter a code"
msgstr "Kod gir"

#: scenes/play/play_menu.gd:705
msgid "Your code"
msgstr "Kodun"

#: scenes/play/play_menu.gd:707 scenes/play/play_menu.gd:792
msgid "Connecting…"
msgstr "Bağlanıyor…"

#: scenes/play/play_menu.gd:710
msgid "Send this code to your friend. The game starts when they enter it."
msgstr "Bu kodu arkadaşına gönder. Kodu girdiğinde oyun başlar."

#: scenes/play/play_menu.gd:713 scenes/play/play_menu.gd:733
msgid "Share"
msgstr "Paylaş"

#: scenes/play/play_menu.gd:715
msgid "Copy"
msgstr "Kopyala"

#. Toast after copying the game code.
#: scenes/play/play_menu.gd:718 scenes/play/play_menu.gd:736
msgid "Copied"
msgstr "Kopyalandı"

#. Message sent with the system share sheet. The first %s is the game's name (Bagh Chal), the second a code like TG-7K4Q. A line with the menu path to enter the code follows it.
#: scenes/play/play_menu.gd:741
#, c-format
msgid "Play %s with me! My game code is %s."
msgstr "Benimle %s oyna! Oyun kodum: %s."

#. Quick match found no one after about a minute.
#: scenes/play/play_menu.gd:772
msgid "No one is free right now"
msgstr "Şu anda müsait kimse yok"

#: scenes/play/play_menu.gd:773
msgid "We can keep looking while you play."
msgstr "Sen oynarken aramaya devam edebiliriz."

#: scenes/play/play_menu.gd:774
msgid "Play against the AI while we keep looking"
msgstr "Biz ararken YZ'ye karşı oyna"

#: scenes/play/play_menu.gd:777
msgid "Keep searching"
msgstr "Aramaya devam et"

#: scenes/play/play_menu.gd:778
msgid "Invite a friend instead"
msgstr "Bunun yerine arkadaşını davet et"

#. Title over a message saying why a game with another player couldn't start.
#: scenes/play/play_menu.gd:798
msgid "Couldn't start the game"
msgstr "Oyun başlatılamadı"

#: scenes/play/play_menu.gd:801
msgid "OK"
msgstr "Tamam"

#. Asked before leaving a game against another player that's still going.
#: scenes/play/play_menu.gd:809
msgid "Leave this game?"
msgstr "Bu oyundan çıkılsın mı?"

#: scenes/play/play_menu.gd:810
msgid "It counts as a loss."
msgstr "Bu yenilgi sayılır."

#: scenes/play/play_menu.gd:811
msgid "Leave"
msgstr "Çık"

#. Button: don't leave the game against another player.
#: scenes/play/play_menu.gd:817
msgid "Stay"
msgstr "Kal"

#. Heading over the list of books and articles at the end of "Game origins".
#: scenes/play/play_menu.gd:842
msgid "Sources"
msgstr "Kaynaklar"

#: scenes/play/play_menu.gd:888
msgid "Offer a draw"
msgstr "Beraberlik teklif et"

#. In-game menu button: end this game and go back to the main menu.
#: scenes/play/play_menu.gd:928
msgid "Quit to main menu"
msgstr "Ana menüye dön"

#. Menu label: the visual style of board and pieces (a noun, not "to look"). Keep it short.
#: scenes/play/play_menu.gd:970
msgid "Look"
msgstr "Görünüm"

#. Settings label next to an on/off switch and a volume slider: the game's sound effects (pieces, end of game). Keep it short.
#: scenes/play/play_menu.gd:973
msgid "Sound"
msgstr "Ses"

#. Settings label next to an on/off switch and a volume slider: the game's music. Keep it short.
#: scenes/play/play_menu.gd:975
msgid "Music"
msgstr "Müzik"

#. Settings switch: makes every text in the game bigger. Keep it short.
#: scenes/play/play_menu.gd:998 tools/smoke_greybox.gd:256 tools/smoke_greybox.gd:305
msgid "Large text"
msgstr "Büyük metin"

#. Settings switch: the phone vibrates lightly when a piece moves, at a capture and at the end of a game. The phone's usual word. Keep it short.
#: scenes/play/play_menu.gd:1002 tools/smoke_greybox.gd:257
msgid "Vibration"
msgstr "Titreşim"

#. Settings button: opens Game Center (iPhone/iPad) or Google Play Games (Android) on the game's achievements. The usual platform word.
#: scenes/play/play_menu.gd:1042
msgid "Achievements"
msgstr "Başarılar"

#. Message when Game Center or Google Play Games can't open (not signed in, offline).
#: scenes/play/play_menu.gd:1046
msgid "Achievements aren't available right now."
msgstr "Başarılar şu anda kullanılamıyor."

#. Settings button and screen title: who made the game, and the open-source licences.
#: scenes/play/play_menu.gd:1048 scenes/play/play_menu.gd:1059 tools/smoke_greybox.gd:269
msgid "Credits"
msgstr "Emeği Geçenler"

#. On the Credits screen. First %s: the game's name (e.g. "Bagh Chal"); second %s: the name of the person who made it.
#: scenes/play/play_menu.gd:1062
#, c-format
msgid "%s is a game by %s."
msgstr "%s, %s tarafından yapılmış bir oyundur."

#. Button and screen title: the licences of the open-source software and fonts the game uses.
#: scenes/play/play_menu.gd:1065 scenes/play/play_menu.gd:1072 scenes/play/play_menu.gd:1112 tools/smoke_greybox.gd:276
msgid "Open-source licenses"
msgstr "Açık kaynak lisansları"

#. On the "Open-source licenses" screen, above the list. "Tap" also covers clicking.
#: scenes/play/play_menu.gd:1074
msgid "This game is made with the software and fonts below. Tap one to read its license."
msgstr "Bu oyun aşağıdaki yazılım ve yazı tipleriyle yapılmıştır. Lisansını okumak için birine dokunun."

#. Title of the screen offering the other looks (styles of board and pieces) for a short video.
#: scenes/play/play_menu.gd:1154
msgid "More looks"
msgstr "Diğer görünümler"

#. On the "More looks" screen. The video is an ad; "until you close the game" means until the app is closed.
#: scenes/play/play_menu.gd:1156
msgid "Watch a short video to switch looks until you close the game."
msgstr "Uygulamayı kapatana kadar görünümü değiştirmek için kısa bir video izle."

#. On the "More looks" screen when no video could be loaded (offline, or none available).
#: scenes/play/play_menu.gd:1160
msgid "No video is ready right now. Try again in a moment."
msgstr "Şu anda hazır bir video yok. Birazdan tekrar dene."

#. Button: play a short video (an ad) to open the other looks.
#: scenes/play/play_menu.gd:1163
msgid "Watch a video"
msgstr "Video izle"

#. On the "More looks" screen, above the Remove ads button: buying it opens every look permanently.
#: scenes/play/play_menu.gd:1179
msgid "Or remove ads to keep every look for good."
msgstr "Ya da reklamları kaldır, tüm görünümler kalıcı olarak senin olsun."

#. Button: buy "Remove ads" (no more ads, and every look of the board open for good). %s is the store's price, e.g. "US$1.99". Keep it short.
#: scenes/play/play_menu.gd:1180 scenes/play/play_menu.gd:1194 tools/smoke_greybox.gd:220 tools/smoke_greybox.gd:252
#, c-format
msgid "Remove ads · %s"
msgstr "Reklamları kaldır · %s"

#. In-game menu button: get back a purchase made before with the same store account (a new phone, a reinstall). The usual store wording. Shares a row with "Privacy choices".
#: scenes/play/play_menu.gd:1200 tools/smoke_greybox.gd:229
msgid "Restore purchases"
msgstr "Satın alımları geri yükle"

#. In-game menu button: shows Google's consent form again, to change the choice about ads and personal data.
#: scenes/play/play_menu.gd:1204
msgid "Privacy choices"
msgstr "Gizlilik tercihleri"

#. Message after buying "Remove ads": thanks, no more ads, and every look (style of board and pieces) is theirs.
#: scenes/play/play_menu.gd:1223
msgid "Thank you! Ads are off and every look is yours."
msgstr "Teşekkürler! Reklamlar kapandı ve tüm görünümler artık senin."

#. Message when the store holds the payment for "Remove ads" (e.g. paying in cash, or a parent must approve).
#: scenes/play/play_menu.gd:1233
msgid "Your payment is pending. Ads will turn off as soon as it goes through."
msgstr "Ödemen beklemede. Ödeme tamamlanır tamamlanmaz reklamlar kapanacak."

#. Message when buying "Remove ads" failed (not when the player cancelled).
#: scenes/play/play_menu.gd:1236
msgid "The purchase didn't go through. Please try again later."
msgstr "Satın alma tamamlanamadı. Lütfen daha sonra tekrar dene."

#. Message after "Restore purchases" found Remove ads.
#: scenes/play/play_menu.gd:1246
msgid "Your purchase is restored."
msgstr "Satın alımın geri yüklendi."

#. Message after "Restore purchases" found nothing bought with this store account.
#: scenes/play/play_menu.gd:1249
msgid "No purchase to restore on this account."
msgstr "Bu hesapta geri yüklenecek satın alım yok."

#. Message when the store (Google Play, the App Store) can't be reached.
#: scenes/play/play_menu.gd:1252
msgid "The store isn't available right now."
msgstr "Mağazaya şu anda ulaşılamıyor."

#. Settings label next to a list: the graphics quality (Auto, High, Medium, Low). Keep it short.
#: scenes/play/play_menu.gd:1274
msgid "Graphics"
msgstr "Grafik"

#. Followed by this player's name as others see it, e.g. "Your name: Potter 4821".
#: scenes/play/play_menu.gd:1355
#, c-format
msgid "Your name: %s"
msgstr "Adın: %s"

#. Shown, with animated dots, while waiting for the other player to join.
#: scenes/play/play_menu.gd:1392
msgid "Waiting"
msgstr "Bekleniyor"

#: scenes/play/play_text.gd:24
msgid "Scribe"
msgstr "Kâtip"

#: scenes/play/play_text.gd:26
msgid "Traveller"
msgstr "Gezgin"

#: scenes/play/play_text.gd:28
msgid "Potter"
msgstr "Çömlekçi"

#: scenes/play/play_text.gd:30 tools/smoke_multiplayer.gd:309
msgid "Weaver"
msgstr "Dokumacı"

#: scenes/play/play_text.gd:32
msgid "Shepherd"
msgstr "Çoban"

#: scenes/play/play_text.gd:34
msgid "Boatman"
msgstr "Kayıkçı"

#: scenes/play/play_text.gd:36
msgid "Gardener"
msgstr "Bahçıvan"

#: scenes/play/play_text.gd:38
msgid "Builder"
msgstr "Usta"

#: scenes/play/play_text.gd:46
msgid "Can't reach the online service. Check your connection and try again."
msgstr "Çevrimiçi hizmete ulaşılamıyor. Bağlantını kontrol edip yeniden dene."

#: scenes/play/play_text.gd:48
msgid "No game has that code. Check it and try again."
msgstr "Bu koda sahip bir oyun yok. Kontrol edip yeniden dene."

#: scenes/play/play_text.gd:50
msgid "That game has already started."
msgstr "O oyun çoktan başladı."

#: scenes/play/play_text.gd:52
msgid "Couldn't connect to the other device."
msgstr "Diğer cihaza bağlanılamadı."

#: scenes/play/play_text.gd:54
