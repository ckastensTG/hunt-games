msgstr[1] "Alınan köpek: %d."

#: titles/common/hunt_text.gd:133
msgid "The tigers are trapped: none of them can move."
msgstr "Kaplanlar kapana kısıldı: hiçbiri hareket edemiyor."

#: titles/common/hunt_text.gd:135
