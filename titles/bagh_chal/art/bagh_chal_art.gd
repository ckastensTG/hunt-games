class_name BaghChalArt
extends RefCounted
## The Bagh Chal art styles, in menu order. The first is the default.
##
##   brass_style.gd  "Temple brass": engraved brass board, cast tigers and
##                   goats, a temple courtyard at dusk (the first style frame).
##   stone_style.gd  "Stone and pebbles": the historical look, a stone with
##                   the lines scratched in, river stones and pebbles, on a
##                   straw mat in a rest house.
##
## Both follow art direction A with touches of B (bible §6). Their assets are
## generated by tools/art/ and can be replaced one for one by outsourced art.


static func styles() -> Array[HuntArtStyle]:
	var out: Array[HuntArtStyle] = [BaghChalBrassStyle.new(), BaghChalStoneStyle.new()]
	return out
