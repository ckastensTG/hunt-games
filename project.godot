; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Timeless Games: Hunt Games (dev)"
run/main_scene="res://scenes/greybox/greybox.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/image="res://addons/timeless_core/branding/splash/TEX_Splash_TimelessGames_Square.png"
config/icon="res://titles/bagh_chal/art/icon_placeholder.png"
config/name.title_bagh_chal="Bagh Chal"
config/name.title_jogo_da_onca="Jogo da Onça"

[autoload]

EOSGRuntime="*res://addons/epic-online-services-godot/runtime.gd"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/timeless_core/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://locale/de.po", "res://locale/es.po", "res://locale/fr.po", "res://locale/it.po", "res://locale/ja.po", "res://locale/ko.po", "res://locale/pl.po", "res://locale/pt_BR.po", "res://locale/ru.po", "res://locale/tr.po", "res://locale/zh_CN.po")
locale/include_text_server_data=true

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
